---
// Starlight component override for Hero (splash pages only — today the two
// landing pages, index.mdx and fr/index.mdx). It keeps the default hero's
// contract (title, tagline and actions come from the `hero` front-matter, the
// h1 keeps the PAGE_TITLE_ID anchor) and swaps the optional image for the
// animated Facet gem below. The gem is inline SVG so it follows the theme
// tokens; every animation sits behind prefers-reduced-motion.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import FacetGem from './landing/FacetGem.astro';

const { data } = Astro.locals.starlightRoute.entry;
const lang = Astro.locals.starlightRoute.lang;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const eyebrow: Record<string, string> = {
	en: 'Governed application platform',
	fr: 'Plateforme applicative gouvernée',
};

const imageFile = image && 'file' in image ? image.file : undefined;
---

<div class="facet-hero">
	<div class="facet-hero__backdrop" aria-hidden="true"></div>
	<div class="facet-hero__copy">
		<p class="facet-hero__eyebrow">
			<span class="facet-hero__eyebrow-dot" aria-hidden="true"></span>
			{eyebrow[lang] ?? eyebrow.en}
		</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="facet-hero__tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="facet-hero__actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<div class="facet-hero__art">
		{imageFile ? <Image src={imageFile} alt={image?.alt || ''} width={400} height={400} loading="eager" /> : <FacetGem />}
	</div>
</div>

<style>
	.facet-hero {
		position: relative;
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 1.5rem;
		padding-block: 2rem 1rem;
		isolation: isolate;
	}

	/* A soft gold wash and a faint grid behind the hero, faded at the edges. */
	.facet-hero__backdrop {
		position: absolute;
		inset: -6rem -50vw -2rem;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(38rem 24rem at 72% 42%, var(--accent-weak), transparent 70%),
			linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 3rem 3rem,
			linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 3rem 3rem;
		mask-image: radial-gradient(60rem 30rem at 50% 40%, #000 20%, transparent 75%);
		opacity: 0.7;
	}

	.facet-hero__copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}

	.facet-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		padding: 0.3rem 0.85rem 0.3rem 0.65rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-2) 80%, transparent);
		color: var(--text-2);
		font-family: var(--font-display);
		font-size: var(--sl-text-sm);
		letter-spacing: 0.02em;
	}

	.facet-hero__eyebrow-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 0 var(--accent-weak);
	}

	h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-4xl), calc(0.5rem + 5.5vw), 4.75rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		font-weight: 700;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	h1 :global(.hero-accent) {
		background: linear-gradient(100deg, #d9822b 0%, #f2c14e 35%, #f8dc94 50%, #f2c14e 65%, #d9822b 100%);
		background-size: 220% 100%;
		background-position: 0% 50%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	/* Darker gold stops on the light theme so the word keeps its contrast. */
	:global([data-theme='light']) h1 :global(.hero-accent) {
		background-image: linear-gradient(100deg, #9a4f12 0%, #c26f22 35%, #e8a33d 50%, #c26f22 65%, #9a4f12 100%);
	}

	.facet-hero__tagline {
		margin: 0;
		max-width: 34ch;
		font-size: clamp(var(--sl-text-lg), calc(0.5rem + 1.4vw), var(--sl-text-2xl));
		line-height: 1.4;
		color: var(--text-2);
		text-wrap: balance;
	}

	.facet-hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1rem;
		margin-top: 0.5rem;
	}

	.facet-hero__actions :global(.sl-link-button) {
		transition:
			transform 160ms ease,
			box-shadow 160ms ease,
			background-color 160ms ease;
	}

	.facet-hero__actions :global(.sl-link-button:hover) {
		transform: translateY(-2px);
	}

	.facet-hero__actions :global(.sl-link-button.primary) {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
		box-shadow: 0 8px 24px -10px var(--accent);
	}

	.facet-hero__actions :global(.sl-link-button.primary:hover) {
		background: var(--accent-press);
		box-shadow: 0 12px 30px -10px var(--accent);
	}

	.facet-hero__actions :global(.sl-link-button.secondary) {
		border-color: var(--border-strong);
		background: color-mix(in srgb, var(--surface-2) 85%, transparent);
	}

	.facet-hero__actions :global(.sl-link-button.secondary:hover) {
		border-color: var(--accent);
	}

	.facet-hero__art {
		width: min(80%, 22rem);
		margin-inline: auto;
	}

	@media (min-width: 50rem) {
		.facet-hero {
			grid-template-columns: 6fr 5fr;
			gap: 2rem;
			padding-block: clamp(2.5rem, calc(1rem + 9vmin), 7rem) clamp(1.5rem, 4vmin, 3rem);
		}

		.facet-hero__copy {
			align-items: flex-start;
			text-align: start;
		}

		.facet-hero__actions {
			justify-content: flex-start;
		}

		.facet-hero__art {
			width: 100%;
			max-width: 30rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.facet-hero__copy > * {
			animation: facet-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}
		.facet-hero__copy > :nth-child(2) {
			animation-delay: 80ms;
		}
		.facet-hero__copy > :nth-child(3) {
			animation-delay: 160ms;
		}
		.facet-hero__copy > :nth-child(4) {
			animation-delay: 240ms;
		}

		h1 :global(.hero-accent) {
			animation: facet-shine 6s ease-in-out 1.2s infinite;
		}

		.facet-hero__eyebrow-dot {
			animation: facet-ping 2.4s ease-out infinite;
		}
	}

	@keyframes facet-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@keyframes facet-shine {
		0%,
		40% {
			background-position: 0% 50%;
		}
		70%,
		100% {
			background-position: 100% 50%;
		}
	}

	@keyframes facet-ping {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
		}
		80%,
		100% {
			box-shadow: 0 0 0 0.6rem transparent;
		}
	}
</style>
