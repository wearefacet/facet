---
// Starlight component override for PageTitle: renders the page title plus the
// "Copy as markdown" button. The button behaviour lives in
// src/scripts/copy-as-markdown.ts, which astro.config.mjs injects on every
// page. The `_top` id mirrors PAGE_TITLE_ID in @astrojs/starlight — it is the
// anchor target Starlight deep-links to.
const title = Astro.locals.starlightRoute.entry.data.title;
---

<div class="page-title">
	<h1 id="_top">{title}</h1>
	<button id="copy-as-markdown" type="button" aria-live="polite">Copy as markdown</button>
</div>

<style>
	/* Replicates the h1 styles of the default PageTitle component. */
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	.page-title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	h1 {
		min-width: 0;
	}

	button {
		margin-left: auto;
		flex-shrink: 0;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 9999px;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs, 0.8rem);
		line-height: 1.2;
		cursor: pointer;
	}

	button:hover,
	button:focus-visible {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-accent);
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
</style>
