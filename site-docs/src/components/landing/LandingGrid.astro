---
// Responsive grid for the landing page's card rows (pillars, doors).
interface Props {
	min?: string;
}
const { min = '15rem' } = Astro.props;
---

<div class="landing-grid not-content" style={`--min:${min}`}><slot /></div>

<style>
	.landing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min)), 1fr));
		gap: 1.25rem;
		margin-top: 1.75rem;
	}
</style>
