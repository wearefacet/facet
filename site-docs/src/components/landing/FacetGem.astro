---
// Animated hero art for the landing page: the Facet "Pavilion Base" gem
// (same geometry as src/assets/facet-lockup-*.svg) assembling facet by facet,
// with apps — a team-built app, an AI agent and the workspace — wired into
// it. Colours come from the theme tokens so it follows light/dark. Every
// animation is behind prefers-reduced-motion; the SMIL packets are hidden
// there too.
const facets = [
	{ points: '50,60 12,60 19.26,37.66', dx: -7, dy: 2 },
	{ points: '50,60 19.26,37.66 38.26,23.86', dx: -5, dy: -5 },
	{ points: '50,60 38.26,23.86 61.74,23.86', dx: 0, dy: -8 },
	{ points: '50,60 61.74,23.86 80.74,37.66', dx: 5, dy: -5 },
	{ points: '50,60 80.74,37.66 88,60', dx: 7, dy: 2 },
];

const wires = [
	{ id: 'fg-wire-a', d: 'M104 96 C 140 104, 152 134, 160 170', delay: '0s' },
	{ id: 'fg-wire-b', d: 'M300 70 C 266 80, 252 112, 244 152', delay: '-1.1s' },
	{ id: 'fg-wire-c', d: 'M292 330 C 262 328, 250 304, 240 280', delay: '-2.2s' },
];
---

<svg class="fg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="fg-title">
	<title id="fg-title">The Facet gem, with apps and an AI agent connected to it</title>
	<defs>
		<radialGradient id="fg-glow" cx="50%" cy="50%" r="50%">
			<stop offset="0%" stop-color="var(--accent)" stop-opacity="0.45"></stop>
			<stop offset="55%" stop-color="var(--accent)" stop-opacity="0.08"></stop>
			<stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
		</radialGradient>
		<linearGradient id="fg-shine" x1="0" x2="1" y1="0" y2="0">
			<stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
			<stop offset="0.5" stop-color="#fff" stop-opacity="0.75"></stop>
			<stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
		</linearGradient>
		<clipPath id="fg-gem-clip">
			<polygon points="12,60 19.26,37.66 38.26,23.86 61.74,23.86 80.74,37.66 88,60"></polygon>
		</clipPath>
		{wires.map((w) => <path id={w.id} d={w.d} />)}
	</defs>

	<!-- glow -->
	<circle class="fg-glow" cx="200" cy="200" r="175" fill="url(#fg-glow)"></circle>

	<!-- orbit ring with travelling data points -->
	<g class="fg-orbit">
		<ellipse cx="200" cy="232" rx="172" ry="54" fill="none" stroke="var(--border-strong)" stroke-dasharray="2 7" stroke-linecap="round"></ellipse>
		<ellipse cx="200" cy="232" rx="132" ry="38" fill="none" stroke="var(--border)" stroke-width="1"></ellipse>
		<path id="fg-orbit-path" d="M28 232 a172 54 0 1 0 344 0 a172 54 0 1 0 -344 0" fill="none"></path>
		<circle class="fg-packet" r="3.2" fill="var(--accent)">
			<animateMotion dur="9s" repeatCount="indefinite"><mpath href="#fg-orbit-path"></mpath></animateMotion>
		</circle>
		<circle class="fg-packet" r="2.4" fill="var(--accent)" opacity="0.7">
			<animateMotion dur="9s" begin="-3s" repeatCount="indefinite"><mpath href="#fg-orbit-path"></mpath></animateMotion>
		</circle>
		<circle class="fg-packet" r="2" fill="var(--text-2)">
			<animateMotion dur="9s" begin="-6s" repeatCount="indefinite"><mpath href="#fg-orbit-path"></mpath></animateMotion>
		</circle>
	</g>

	<!-- wires from apps into the gem -->
	<g class="fg-wires" fill="none" stroke-linecap="round">
		{
			wires.map((w) => (
				<g>
					<use href={`#${w.id}`} stroke="var(--border-strong)" stroke-width="1.5" />
					<use href={`#${w.id}`} class="fg-flow" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 9" style={`animation-delay:${w.delay}`} />
					<circle class="fg-packet" r="3" fill="var(--accent)">
						<animateMotion dur="2.6s" begin={w.delay} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
							<mpath href={`#${w.id}`} />
						</animateMotion>
					</circle>
				</g>
			))
		}
	</g>

	<!-- the gem: five facets over the foundation bar, scaled from the logo -->
	<g transform="translate(50 40) scale(3)">
		<g class="fg-gem">
			{
				facets.map((f, i) => (
					<polygon
						class={`fg-facet fg-facet-${i + 1}`}
						points={f.points}
						stroke-width="0.35"
						stroke-linejoin="round"
						style={`--dx:${f.dx}px;--dy:${f.dy}px;--i:${i}`}
					/>
				))
			}
			{facets.map((f, i) => <polygon class="fg-glint" points={f.points} fill="#fff" style={`--i:${i}`} />)}
			<g clip-path="url(#fg-gem-clip)">
				<rect class="fg-sweep" x="-30" y="10" width="16" height="60" fill="url(#fg-shine)" transform="skewX(-20)"></rect>
			</g>
		</g>
		<polygon class="fg-base" points="13,67 87,67 77,77 23,77" stroke-width="2" stroke-linejoin="round"></polygon>
	</g>

	<!-- sparkles above the gem -->
	<g class="fg-sparkles" fill="var(--accent)">
		<path class="fg-spark" style="--d:0s" d="M200 86 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3z"></path>
		<path class="fg-spark" style="--d:1.3s" d="M262 112 l2 6 6 2 -6 2 -2 6 -2 -6 -6 -2 6 -2z"></path>
		<path class="fg-spark" style="--d:2.4s" d="M140 118 l1.6 4.8 4.8 1.6 -4.8 1.6 -1.6 4.8 -1.6 -4.8 -4.8 -1.6 4.8 -1.6z"></path>
	</g>

	<!-- app cards -->
	<g class="fg-card" style="--b:0s">
		<rect x="24" y="58" width="80" height="60" rx="10" fill="var(--surface)" stroke="var(--border-strong)"></rect>
		<circle cx="36" cy="70" r="2.2" fill="var(--border-strong)"></circle>
		<circle cx="44" cy="70" r="2.2" fill="var(--border-strong)"></circle>
		<circle cx="52" cy="70" r="2.2" fill="var(--border-strong)"></circle>
		<rect x="34" y="80" width="40" height="5" rx="2.5" fill="var(--accent)"></rect>
		<rect x="34" y="91" width="58" height="4" rx="2" fill="var(--border-strong)"></rect>
		<rect x="34" y="100" width="46" height="4" rx="2" fill="var(--border-strong)"></rect>
	</g>
	<g class="fg-card" style="--b:-1.6s">
		<rect x="300" y="36" width="72" height="60" rx="10" fill="var(--surface)" stroke="var(--border-strong)"></rect>
		<path class="fg-ai" d="M336 48 l4.5 12 12 4.5 -12 4.5 -4.5 12 -4.5 -12 -12 -4.5 12 -4.5z" fill="var(--accent)"></path>
		<path d="M356 76 l1.8 4.6 4.6 1.8 -4.6 1.8 -1.8 4.6 -1.8 -4.6 -4.6 -1.8 4.6 -1.8z" fill="var(--text-2)"></path>
	</g>
	<g class="fg-card" style="--b:-3.1s">
		<rect x="292" y="302" width="84" height="58" rx="10" fill="var(--surface)" stroke="var(--border-strong)"></rect>
		<rect x="302" y="313" width="64" height="8" rx="2" fill="var(--accent-weak)"></rect>
		<g fill="var(--border-strong)">
			<rect x="302" y="326" width="18" height="5" rx="1.5"></rect>
			<rect x="324" y="326" width="18" height="5" rx="1.5"></rect>
			<rect x="346" y="326" width="20" height="5" rx="1.5"></rect>
			<rect x="302" y="336" width="18" height="5" rx="1.5"></rect>
			<rect x="324" y="336" width="18" height="5" rx="1.5"></rect>
			<rect x="346" y="336" width="20" height="5" rx="1.5"></rect>
			<rect x="302" y="346" width="18" height="5" rx="1.5"></rect>
			<rect x="324" y="346" width="18" height="5" rx="1.5"></rect>
		</g>
		<rect x="346" y="346" width="20" height="5" rx="1.5" fill="var(--accent)"></rect>
	</g>
</svg>

<style>
	.fg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		/* Facet colours per theme, matching the two logo lockups. */
		--fg-1: #c26f22;
		--fg-2: #d9822b;
		--fg-3: #f2c14e;
		--fg-4: #e8a33d;
		--fg-5: #9a4f12;
		--fg-base: #1e1e1e;
	}

	:global([data-theme='dark']) .fg {
		--fg-1: #d9822b;
		--fg-2: #e8a33d;
		--fg-3: #f8dc94;
		--fg-4: #f2c14e;
		--fg-5: #b8621b;
		--fg-base: #ffffff;
	}

	.fg-facet-1 { fill: var(--fg-1); stroke: var(--fg-1); }
	.fg-facet-2 { fill: var(--fg-2); stroke: var(--fg-2); }
	.fg-facet-3 { fill: var(--fg-3); stroke: var(--fg-3); }
	.fg-facet-4 { fill: var(--fg-4); stroke: var(--fg-4); }
	.fg-facet-5 { fill: var(--fg-5); stroke: var(--fg-5); }
	.fg-base { fill: var(--fg-base); stroke: var(--fg-base); }

	.fg-glint {
		opacity: 0;
	}

	.fg-gem {
		filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--accent) 35%, transparent));
	}

	@media (prefers-reduced-motion: reduce) {
		.fg-packet,
		.fg-sweep {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.fg-glow {
			transform-box: fill-box;
			transform-origin: center;
			animation: fg-breathe 6s ease-in-out infinite;
		}

		.fg-facet {
			animation: fg-assemble 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
			animation-delay: calc(250ms + var(--i) * 110ms);
		}

		.fg-glint {
			animation: fg-glint 7.5s ease-in-out infinite;
			animation-delay: calc(1.8s + var(--i) * 0.45s);
		}

		.fg-sweep {
			animation: fg-sweep 7.5s ease-in-out 1.6s infinite;
		}

		.fg-base {
			animation: fg-base 800ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms both;
		}

		.fg-flow {
			animation: fg-flow 1.2s linear infinite;
		}

		.fg-card {
			animation:
				fg-fade 700ms ease-out 900ms both,
				fg-bob 6s ease-in-out infinite;
			animation-delay: 900ms, var(--b);
		}

		.fg-ai {
			transform-box: fill-box;
			transform-origin: center;
			animation: fg-spin 8s linear infinite;
		}

		.fg-spark {
			transform-box: fill-box;
			transform-origin: center;
			animation: fg-twinkle 3.6s ease-in-out infinite;
			animation-delay: var(--d);
		}

		.fg-wires,
		.fg-orbit {
			animation: fg-fade 900ms ease-out 1.1s both;
		}
	}

	@keyframes fg-assemble {
		from {
			opacity: 0;
			transform: translate(var(--dx), var(--dy));
		}
	}

	@keyframes fg-base {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	@keyframes fg-fade {
		from {
			opacity: 0;
		}
	}

	@keyframes fg-breathe {
		0%,
		100% {
			opacity: 0.75;
			transform: scale(0.96);
		}
		50% {
			opacity: 1;
			transform: scale(1.04);
		}
	}

	@keyframes fg-glint {
		0%,
		8%,
		100% {
			opacity: 0;
		}
		4% {
			opacity: 0.38;
		}
	}

	@keyframes fg-sweep {
		0% {
			transform: skewX(-20deg) translateX(0);
		}
		35%,
		100% {
			transform: skewX(-20deg) translateX(140px);
		}
	}

	@keyframes fg-flow {
		to {
			stroke-dashoffset: -12;
		}
	}

	@keyframes fg-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-5px);
		}
	}

	@keyframes fg-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes fg-twinkle {
		0%,
		100% {
			opacity: 0.15;
			transform: scale(0.6);
		}
		50% {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
