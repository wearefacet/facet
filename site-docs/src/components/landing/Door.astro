---
// An entry door on the landing page (Evaluate / Build / Operate): a numbered
// card with an icon, a short description (the slot) and a hover reveal.
interface Props {
	href: string;
	title: string;
	step: string;
	icon: 'evaluate' | 'build' | 'operate';
}
const { href, title, step, icon } = Astro.props;
---

<a class="door not-content" href={href}>
	<span class="door__glow" aria-hidden="true"></span>
	<span class="door__top">
		<span class="door__icon" aria-hidden="true">
			{
				icon === 'evaluate' && (
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="6.5" />
						<path d="M16 16 l4.5 4.5" />
						<path d="M8.5 11.2 l1.8 1.8 3.4 -3.6" />
					</svg>
				)
			}
			{
				icon === 'build' && (
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 3 l8 4.5 v9 L12 21 l-8 -4.5 v-9z" />
						<path d="M4 7.5 l8 4.5 8 -4.5" />
						<path d="M12 12 v9" />
					</svg>
				)
			}
			{
				icon === 'operate' && (
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3.5" y="4" width="17" height="6.5" rx="2" />
						<rect x="3.5" y="13.5" width="17" height="6.5" rx="2" />
						<path d="M7.5 7.25 h.01 M7.5 16.75 h.01" stroke-width="2.6" />
						<path d="M12 7.25 h5 M12 16.75 h5" />
					</svg>
				)
			}
		</span>
		<span class="door__step">{step}</span>
	</span>
	<span class="door__title">
		{title}
		<svg class="door__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</svg>
	</span>
	<span class="door__body"><slot /></span>
</a>

<style>
	.door {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: var(--surface-2);
		color: var(--text);
		text-decoration: none;
		isolation: isolate;
		transition:
			border-color 200ms ease,
			transform 200ms ease,
			box-shadow 200ms ease;
	}

	.door:hover,
	.door:focus-visible {
		border-color: color-mix(in srgb, var(--accent) 70%, var(--border));
		transform: translateY(-4px);
		box-shadow: var(--sl-shadow-lg);
	}

	.door:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.door__glow {
		position: absolute;
		inset: auto -30% -60% auto;
		z-index: -1;
		width: 16rem;
		height: 16rem;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--accent-weak), transparent);
		opacity: 0;
		transition: opacity 300ms ease;
	}

	.door:hover .door__glow {
		opacity: 1;
	}

	.door__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.door__icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		background: var(--accent-weak);
		color: var(--accent-ink);
	}

	.door__icon svg {
		width: 1.4rem;
		height: 1.4rem;
	}

	.door__step {
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
		color: var(--text-3);
		letter-spacing: 0.08em;
	}

	.door__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 600;
	}

	.door__arrow {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--accent-ink);
		transition: transform 200ms ease;
	}

	.door:hover .door__arrow {
		transform: translateX(4px);
	}

	.door__body {
		color: var(--text-2);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
</style>
