# Template for the git-ignored dotenv files at the repository root.
# Precedence: shell exports win, then `.env`, then `.env.$APP_ENV` —
# see doc/backend/cli.md → Dotenv loader.

# ── Spec suite (`make test`) ─────────────────────────────────────────────
# Copy this file to `.env.test`. The URL points at the throwaway
# PostgreSQL from compose.test.yml on port 5433. spec_helper.cr rewrites
# the path onto the per-worker database, so only the host, port, and
# credentials matter.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/facet_test

# ── Dev stack (`scripts/dev`) ────────────────────────────────────────────
# Copy this file to `.env` and point DATABASE_URL at your own PostgreSQL
# instance. Do not keep the 5433 URL above: it belongs to the throwaway
# suite instance, not to the dev backend.
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/facet

# Shared addresses for Caddy and the frontend. Caddy carries the same
# defaults, so uncomment only to override.
#BACKEND_URL=http://127.0.0.1:3000
#FRONTEND_URL=[::1]:5173

# ── JWT_SIGNING_KEY (optional) ───────────────────────────────────────────
# A P-256 private key in PEM form. When unset, each process generates a
# temporary key: tokens stop verifying after a restart. Fine for dev and
# the suite; set it in production. Generate one with:
#   openssl ecparam -name prime256v1 -genkey -noout
# See doc/backend/iam.md → Facet::IAM::JWT.
#JWT_SIGNING_KEY=
