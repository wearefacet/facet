require "../spec_helper"

# app.App registration schema.
#
# Covers:
#   - An app with grants can be created, read, updated, and disabled via
#     the standard document API.
#   - Grants round-trip verbatim; every target is concrete (the wildcard
#     form `domain.*` is refused at authoring time).
#   - client_id is autogenerated by the create Lua hook and is read-only
#     (caller-supplied values are ignored).
#   - The RBAC gate is the standard create/update/delete/read model:
#     * a wildcard admin role (*.*) can do everything;
#     * a viewer role (read-only on *.*) can read but not create/update/delete;
#     * an editor role (create/update/delete/read on *.*) can manage apps.
#
# The app.App doctype and the app core.Domain row are seeded in the
# template database by Doctype::Seed before the suite runs, so no per-test
# seeding of the schema is necessary.

# Builds a request body for a fully-populated app with a wildcard grant
# (crm.*) and an explicit-doctype grant (crm.Contact). The slug is
# parameterised so each call produces a distinct, collision-free row.
def app_body(slug : String, overrides : String = "{}") : String
  base = %({
    "slug": "#{slug}",
    "name": "CRM Portal",
    "description": "External CRM frontend.",
    "client_type": "public",
    "redirect_uris": ["https://crm.example.com/oauth/callback"],
    "allowed_origins": ["https://crm.example.com"],
    "host": "crm.example.com",
    "status": "draft",
    "compatible_roles": ["iam.Roles.admin"],
    "grants": [
      {"target": "crm.Contact", "actions": [{"name": "read",  "required": true}]},
      {"target": "crm.Pipeline", "actions": [{"name": "read",  "required": false}, {"name": "write", "required": false}]}
    ]
  })
  # Merge overrides on top so individual tests can flip a single field.
  JSON.parse(base).as_h.merge(JSON.parse(overrides).as_h).to_json
end

# Creates an app as the system principal and returns the resulting projection.
def create_app(db, slug = "crm-portal-#{unique_suffix}", overrides : String = "{}")
  body = app_body(slug, overrides)
  result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
  {slug, expect_create_success(result).projection}
end

# Builds an AuthContext carrying a single role with the given permission
# lines. Each line is {"action", "on"} with no scope (unrestricted).
def app_rbac_ctx(account_id : String, perms : Array({String, String})) : Facet::RBAC::AuthContext
  permissions = perms.map do |action, on|
    parts = on.split('.')
    Facet::RBAC::Permission.new(action: action, domain: parts[0], path: parts[1..])
  end
  role = Facet::RBAC::ActiveRole.new(
    role_id: "test_role",
    visible_tags: Set{"default"},
    permissions: permissions,
  )
  Facet::RBAC::AuthContext.authenticated(account_id, role)
end

def app_rbac_body
  %({
    "slug": "rbac-#{unique_suffix}",
    "name": "RBAC App",
    "description": "RBAC test app"
  })
end

describe "app.App registration (Phase 1)" do
  # Re-register the meta `core.DocType`/`core.Domain` rows and the `app`
  # domain row + `app.App` doctype definition. The global per-example
  # TRUNCATE wipes projections, so the seeded doctype definitions are gone
  # unless we restore them before each example.
  before_each do
    with_db { |db| seed_app_doctypes(db) }
  end

  describe "create + read" do
    it "creates an app and round-trips every field through read" do
      with_db do |db|
        slug, proj = create_app(db)

        # id is a bare ULID (Document::Create never produces the qualified form).
        proj.id.should_not be_empty
        proj.id.should_not contain(".")

        content = proj.content
        content["slug"].as_s.should eq(slug)
        content["name"].as_s.should eq("CRM Portal")
        content["client_type"].as_s.should eq("public")
        content["status"].as_s.should eq("draft")

        uris = content["redirect_uris"].as_a.map(&.as_s)
        uris.should eq(["https://crm.example.com/oauth/callback"])

        origins = content["allowed_origins"].as_a.map(&.as_s)
        origins.should eq(["https://crm.example.com"])

        roles = content["compatible_roles"].as_a.map(&.as_s)
        roles.should eq(["iam.Roles.admin"])
      end
    end

    it "round-trips the backend-app fields (client_type, service_role_id)" do
      with_db do |db|
        # service_role_id is a reference to iam.Roles — the reference
        # validator requires the target doctype AND document to exist.
        seed_iam_doctypes(db)
        seed_test_roles(db)

        slug = "backend-#{unique_suffix}"
        body = %({
          "slug": "#{slug}",
          "name": "Backend CRM",
          "client_type": "confidential",
          "service_role_id": "iam.Roles.admin",
          "status": "draft",
          "grants": []
        })
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        proj = expect_create_success(result).projection

        content = proj.content
        content["client_type"].as_s.should eq("confidential")
        content["service_role_id"].as_s.should eq("iam.Roles.admin")
        # The service account link is written by the key-issuance path only.
        content["service_account_id"]?.should be_nil
      end
    end

    it "rejects a create missing a required field (slug)" do
      with_db do |db|
        body = %({"name": "No Slug"})
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        # The validation error names the missing field.
        err.details.should_not be_nil
        err.details.not_nil!.any? { |e| e.field == "slug" }.should be_true
      end
    end
  end

  describe "client_id is autogenerated and read-only" do
    it "populates client_id with a ULID-shaped value on create" do
      with_db do |db|
        _, proj = create_app(db)
        client_id = proj.content["client_id"].as_s
        # ULID layout: 26 chars, Crockford Base32 alphabet.
        client_id.size.should eq(26)
        client_id.should match(/^[0-9A-HJKMNP-TV-Z]{26}$/)
      end
    end

    it "rejects a caller-supplied client_id with a read-only violation" do
      with_db do |db|
        body = app_body("forced-#{unique_suffix}", %({"client_id": "NOT_A_ULID"}))
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        # The validator rejects the read-only field before the create hook
        # has a chance to overwrite it; clients cannot smuggle a value in.
        err.details.should_not be_nil
        err.details.not_nil!.any? { |e| e.field == "client_id" && e.code == "read_only" }.should be_true
      end
    end

    it "produces distinct client_ids for distinct apps" do
      with_db do |db|
        # `host` is unique across apps, so each app carries its own host and a
        # matching origin (the origin gate requires the origin's scheme + host
        # to equal the app's own host).
        suffix_a = unique_suffix
        suffix_b = unique_suffix
        _, proj_a = create_app(db, "a-#{suffix_a}", %({"host": "a-#{suffix_a}.example.com", "allowed_origins": ["https://a-#{suffix_a}.example.com"]}))
        _, proj_b = create_app(db, "b-#{suffix_b}", %({"host": "b-#{suffix_b}.example.com", "allowed_origins": ["https://b-#{suffix_b}.example.com"]}))
        proj_a.content["client_id"].as_s.should_not eq(proj_b.content["client_id"].as_s)
      end
    end
  end

  describe "grants round-trip" do
    it "stores and returns grants verbatim" do
      with_db do |db|
        _, proj = create_app(db)
        grants = proj.content["grants"].as_a
        grants.size.should eq(2)

        targets = grants.map(&.["target"].as_s)
        targets.should contain("crm.Contact")
        targets.should contain("crm.Pipeline")

        contact = grants.find! { |g| g["target"].as_s == "crm.Contact" }
        contact_actions = contact["actions"].as_a.map { |a| {a["name"].as_s, a["required"]?.try(&.as_bool) || false} }
        contact_actions.should eq([{"read", true}])

        pipeline = grants.find! { |g| g["target"].as_s == "crm.Pipeline" }
        pipeline_actions = pipeline["actions"].as_a.map { |a| {a["name"].as_s, a["required"]?.try(&.as_bool) || false} }
        pipeline_actions.should eq([{"read", false}, {"write", false}])
      end
    end

    it "accepts an app with no grants (empty array)" do
      with_db do |db|
        body = app_body("nogrants-#{unique_suffix}", %({"grants": []}))
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        proj = expect_create_success(result).projection
        # The create Lua hook round-trips `ctx.root` through the Lua VM.
        # `Lua::Engine` tags Crystal-pushed arrays with a marker metatable
        # so an empty array survives the round-trip as an empty array, not
        # as an empty hash. See `doc/backend/workflow.md` (Lua engine
        # quirks) and `src/lua/engine.cr` (`ARRAY_MARKER_METATABLE`).
        grants_value = proj.content["grants"]
        grants_value.as_a.should be_empty
      end
    end
  end

  describe "update + disable" do
    it "updates an app's status from draft to disabled" do
      with_db do |db|
        slug, proj = create_app(db)
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, %({"status": "disabled"}),
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::Document::Update::Result)

        read = Facet::Document::Read.call(
          db, "app", "App", proj.id, Facet::RBAC::AuthContext.system,
        )
        read.should be_a(Facet::Document::Read::Result)
        content = read.as(Facet::Document::Read::Result).projection.content
        content["status"].as_s.should eq("disabled")
        # update does not touch immutable fields.
        content["slug"].as_s.should eq(slug)
      end
    end

    it "rejects an update that attempts to overwrite client_id (read-only)" do
      with_db do |db|
        _, proj = create_app(db)
        original_client_id = proj.content["client_id"].as_s

        # An attempt to overwrite client_id via update is rejected at
        # validation time: read_only fields cannot be touched by callers.
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, %({"client_id": "ATTACKER_VALUE"}),
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::ServiceError)
        err = upd.as(Facet::ServiceError)
        err.status.should eq(422)
        err.details.should_not be_nil
        err.details.not_nil!.any? { |e| e.field == "client_id" && e.code == "read_only" }.should be_true

        # The stored value is unchanged.
        read = Facet::Document::Read.call(
          db, "app", "App", proj.id, Facet::RBAC::AuthContext.system,
        )
        content = read.as(Facet::Document::Read::Result).projection.content
        content["client_id"].as_s.should eq(original_client_id)
      end
    end

    it "rejects an update that changes slug (immutable after creation)" do
      with_db do |db|
        slug, proj = create_app(db, "immutable-#{unique_suffix}")

        # The `update` Lua hook rejects any patch that asks to move the
        # slug to a fresh value. Enforced at the lifecycle layer, not via
        # `read_only` (which would also block the create-time write).
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, %({"slug": "renamed-#{unique_suffix}"}),
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::ServiceError)
        err = upd.as(Facet::ServiceError)
        err.status.should eq(422)
        err.message.should eq("Script validation failed")
        err.details.should_not be_nil
        err.details.not_nil!.any? { |e| e.code == "script" && e.message.includes?("slug is immutable") }.should be_true

        # The stored value is unchanged.
        read = Facet::Document::Read.call(
          db, "app", "App", proj.id, Facet::RBAC::AuthContext.system,
        )
        content = read.as(Facet::Document::Read::Result).projection.content
        content["slug"].as_s.should eq(slug)
      end
    end

    it "allows an update that does not touch slug" do
      with_db do |db|
        slug, proj = create_app(db, "untouched-#{unique_suffix}")

        # The patch keeps slug absent, so ctx.patch.slug is nil in the
        # hook and the immutability check is skipped.
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, %({"name": "Renamed"}),
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::Document::Update::Result)
        content = upd.as(Facet::Document::Update::Result).projection.content
        content["slug"].as_s.should eq(slug)
        content["name"].as_s.should eq("Renamed")
      end
    end

    it "rejects an update that resubmits the same slug value" do
      with_db do |db|
        slug, proj = create_app(db, "resubmit-#{unique_suffix}")

        # Even when the resubmitted value matches the current one, the
        # hook rejects the patch: `slug` is set once at create, never
        # sent on update. Mirrors `read_only` on `client_id` but scoped
        # to PATCH only (create must still write the initial value).
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, %({"slug": "#{slug}", "status": "active"}),
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::ServiceError)
        err = upd.as(Facet::ServiceError)
        err.status.should eq(422)
        err.details.not_nil!.any? { |e| e.code == "script" && e.message.includes?("slug is immutable") }.should be_true

        # The stored value is unchanged.
        content = Facet::Document::Read.call(
          db, "app", "App", proj.id, Facet::RBAC::AuthContext.system,
        ).as(Facet::Document::Read::Result).projection.content
        content["slug"].as_s.should eq(slug)
        content["status"].as_s.should eq("draft")
      end
    end

    it "widens an app's grants via update" do
      with_db do |db|
        _, proj = create_app(db)

        new_grants = %({
          "grants": [
            {"target": "crm.Pipeline", "actions": [
              {"name": "read",  "required": true},
              {"name": "write", "required": true},
              {"name": "delete", "required": true}
            ]}
          ]
        })
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id, new_grants,
          Facet::RBAC::AuthContext.system,
        )
        upd.should be_a(Facet::Document::Update::Result)

        read = Facet::Document::Read.call(
          db, "app", "App", proj.id, Facet::RBAC::AuthContext.system,
        )
        content = read.as(Facet::Document::Read::Result).projection.content
        grants = content["grants"].as_a
        grants.size.should eq(1)
        grants.first["target"].as_s.should eq("crm.Pipeline")
        actions = grants.first["actions"].as_a.map(&.["name"].as_s)
        # The grant is stored verbatim; `write` expansion is a resolver-side
        # concern, not a storage concern. Stored form preserves `write`.
        actions.should eq(["read", "write", "delete"])
      end
    end
  end

  describe "grants authoring gate (concrete targets only)" do
    it "rejects a wildcard grant target on create (422, names the target)" do
      with_db do |db|
        body = app_body("wild-#{unique_suffix}", %({
          "grants": [{"target": "crm.*", "actions": [{"name": "read", "required": true}]}]
        }))
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        err.details.not_nil!.any? do |e|
          e.field == "grants[0].target" && e.code == "wildcard_target" &&
            e.message.includes?("crm.*")
        end.should be_true
      end
    end

    it "rejects a wildcard grant target introduced by update (422)" do
      with_db do |db|
        _, proj = create_app(db)
        upd = Facet::Document::Update.call(
          db, "app", "App", proj.id,
          %({"grants": [{"target": "crm.*", "actions": [{"name": "read", "required": true}]}]}),
          Facet::RBAC::AuthContext.system,
        )
        err = upd.as(Facet::ServiceError)
        err.status.should eq(422)
        err.details.not_nil!.any? { |e| e.code == "wildcard_target" }.should be_true
      end
    end

    it "rejects the global wildcard '*.*' as unparseable (422, schema)" do
      with_db do |db|
        body = app_body("global-wild-#{unique_suffix}", %({
          "grants": [{"target": "*.*", "actions": [{"name": "read", "required": true}]}]
        }))
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        err.details.not_nil!.any? { |e| e.field == "grants[0]" && e.code == "schema" }.should be_true
      end
    end

    it "rejects a malformed grants entry at authoring time (422)" do
      # The doctype definition's structural validation (array-of-objects
      # with required properties) fires first: a missing `target` is a
      # required-field refusal, naming `grants.0.target`. The authoring
      # gate adds what shape validation cannot express — the wildcard
      # refusal and the full grant parse.
      with_db do |db|
        body = app_body("malformed-#{unique_suffix}", %({
          "grants": [{"actions": [{"name": "read", "required": true}]}]
        }))
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        err.details.not_nil!.any? { |e| e.field == "grants.0.target" && e.code == "required" }.should be_true
      end
    end
  end
end

def create_host_app(db, host : String?)
  body = %({"slug": "host-#{unique_suffix}", "name": "Host App", "host": #{host ? %("#{host}") : "null"}})
  Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
end

describe "app.App host field (deployment serving)" do
  before_each do
    with_db { |db| seed_app_doctypes(db) }
  end

  it "round-trips a valid host and allows a later move" do
    with_db do |db|
      result = create_host_app(db, "hr.app.example.com")
      proj = expect_create_success(result).projection
      proj.content["host"].as_s.should eq("hr.app.example.com")

      upd = Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"host": "hr2.app.example.com"}),
        Facet::RBAC::AuthContext.system,
      )
      upd.should be_a(Facet::Document::Update::Result)
      upd.as(Facet::Document::Update::Result).projection.content["host"].as_s.should eq("hr2.app.example.com")
    end
  end

  it "rejects a host Facet itself answers at" do
    with_db do |db|
      reserved = Facet::Util::ScriptHelpers.facet_hosts.first
      result = create_host_app(db, reserved)
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("reserved by Facet")).should be_true

      # A port-carrying form fails the shape rule first — a stored host
      # never carries a port (B-211); the deployment target supplies the
      # port at serve time.
      result = create_host_app(db, "#{reserved}:9999")
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("lowercase hostname")).should be_true

      # Loopback literals are reserved: internal traffic (SSR fetches,
      # probes) is addressed by IP, and an app claiming it would intercept
      # every such request.
      result = create_host_app(db, "127.0.0.1")
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("reserved by Facet")).should be_true

      # The port-carrying form fails the shape rule first — a host never
      # carries a port (B-211).
      result = create_host_app(db, "127.0.0.1:9999")
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("lowercase hostname")).should be_true

      # `::1` never reaches the reserved-list compare — the shape rule
      # forbids colons — but the dispatcher still falls through on it, so
      # an app can never serve at the IPv6 loopback.
      result = create_host_app(db, "::1")
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("lowercase hostname")).should be_true
    end
  end

  it "rejects malformed host shapes" do
    with_db do |db|
      ["https://hr.app.example.com", "hr.app.example.com/path", "*.app.example.com",
       "HR.App.Example.COM", "-leading.example.com", "trailing-.example.com",
       "hr app.example.com", "hr_app.example.com",
       "hr.app.example.com:8443", "localhost:3000"].each do |bad|
        result = create_host_app(db, bad)
        err = expect_create_error(result, 422)
        err.details.not_nil!.any?(&.message.includes?("lowercase hostname")).should be_true
      end
    end
  end

  it "enforces uniqueness across apps (nil host is always allowed)" do
    with_db do |db|
      first = expect_create_success(create_host_app(db, "dup.app.example.com")).projection

      dup = create_host_app(db, "dup.app.example.com")
      err = expect_create_error(dup, 422)
      err.details.not_nil!.any? { |e| e.code == "unique" }.should be_true

      # Uniqueness does not block updates that keep the app's own host.
      upd = Facet::Document::Update.call(
        db, "app", "App", first.id, %({"status": "active"}),
        Facet::RBAC::AuthContext.system,
      )
      upd.should be_a(Facet::Document::Update::Result)

      # Absent host is fine — an app without one is never dispatched.
      no_host = create_host_app(db, nil)
      expect_create_success(no_host)
    end
  end
end

describe "app.App allowed_origins (CORS origin gate)" do
  before_each do
    with_db { |db| seed_app_doctypes(db) }
  end

  it "accepts well-formed origins (https any host, http loopback, several entries)" do
    with_db do |db|
      body = %({
        "slug": "origins-ok-#{unique_suffix}",
        "name": "Origins OK",
        "host": "crm.example.com",
        "allowed_origins": ["https://crm.example.com", "http://localhost:5173", "https://partner.example.org:8443"]
      })
      result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
      proj = expect_create_success(result).projection
      proj.content["allowed_origins"].as_a.map(&.as_s).should eq(
        ["https://crm.example.com", "http://localhost:5173", "https://partner.example.org:8443"])
    end
  end

  it "rejects a malformed origin shape (path, wildcard, http on a remote host, bare host, bad port)" do
    with_db do |db|
      ["https://crm.example.com/path", "https://*.crm.example.com", "http://crm.example.com",
       "https://crm.example.com:99999", "crm.example.com"].each do |bad|
        body = %({
          "slug": "origins-bad-#{unique_suffix}",
          "name": "Origins Bad",
          "host": "crm.example.com",
          "allowed_origins": [#{bad.to_json}]
        })
        result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
        err = expect_create_error(result, 422)
        err.details.not_nil!.any?(&.message.includes?("bare origin")).should be_true, "expected shape rejection: #{bad}"
      end
    end
  end

  it "rejects a non-array allowed_origins" do
    with_db do |db|
      body = %({
        "slug": "origins-type-#{unique_suffix}",
        "name": "Origins Type",
        "allowed_origins": "https://crm.example.com"
      })
      result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
      err = expect_create_error(result, 422)
      err.details.not_nil!.any?(&.message.includes?("must be an array")).should be_true
    end
  end

  it "rejects a malformed origin introduced by update (422)" do
    with_db do |db|
      create = %({
        "slug": "origins-upd-#{unique_suffix}",
        "name": "Origins Update",
        "host": "crm.example.com",
        "allowed_origins": ["https://crm.example.com"]
      })
      proj = expect_create_success(
        Facet::Document::Create.call(db, "app", "App", create, Facet::RBAC::AuthContext.system)).projection

      upd = Facet::Document::Update.call(
        db, "app", "App", proj.id,
        %({"allowed_origins": ["https://evil.example.com/path"]}),
        Facet::RBAC::AuthContext.system)
      err = expect_update_error(upd, 422)
      err.details.not_nil!.any?(&.message.includes?("bare origin")).should be_true
    end
  end
end

describe "app.App RBAC (standard create/update/delete/read model)" do
  before_each do
    with_db { |db| seed_app_doctypes(db) }
  end

  it "lets a wildcard admin role (*.*) create, update, delete, read apps" do
    with_db do |db|
      admin = app_rbac_ctx("admin_1", [{"*", "*.*"}])
      result = Facet::Document::Create.call(db, "app", "App", app_rbac_body, admin)
      proj = expect_create_success(result).projection

      upd = Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"status": "active"}), admin,
      )
      upd.should be_a(Facet::Document::Update::Result)

      read = Facet::Document::Read.call(db, "app", "App", proj.id, admin)
      read.should be_a(Facet::Document::Read::Result)

      del = Facet::Document::Delete.call(db, "app", "App", proj.id, admin)
      del.should be_a(Facet::Document::Delete::Result)
    end
  end

  it "lets an editor (create/update/delete/read on *.*) manage apps" do
    with_db do |db|
      editor = app_rbac_ctx("editor_1", [
        {"create", "*.*"},
        {"update", "*.*"},
        {"delete", "*.*"},
        {"read", "*.*"},
      ])
      result = Facet::Document::Create.call(db, "app", "App", app_rbac_body, editor)
      proj = expect_create_success(result).projection

      upd = Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"status": "disabled"}), editor,
      )
      upd.should be_a(Facet::Document::Update::Result)

      del = Facet::Document::Delete.call(db, "app", "App", proj.id, editor)
      del.should be_a(Facet::Document::Delete::Result)
    end
  end

  it "blocks a viewer (read-only on *.*) from create / update / delete" do
    with_db do |db|
      viewer = app_rbac_ctx("viewer_1", [{"read", "*.*"}])

      result = Facet::Document::Create.call(db, "app", "App", app_rbac_body, viewer)
      err = expect_create_error(result, 403)
      err.message.should contain("Forbidden")

      # Seed an app as system so the viewer has a target to attack.
      seeded = Facet::Document::Create.call(
        db, "app", "App", app_rbac_body, Facet::RBAC::AuthContext.system,
      )
      proj = expect_create_success(seeded).projection

      upd = Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"status": "active"}), viewer,
      )
      upd.should be_a(Facet::ServiceError)
      upd.as(Facet::ServiceError).status.should eq(403)

      del = Facet::Document::Delete.call(db, "app", "App", proj.id, viewer)
      del.should be_a(Facet::ServiceError)
      del.as(Facet::ServiceError).status.should eq(403)

      # But the viewer CAN read apps (read is on *.*) — the registration
      # list is non-secret policy, so read access is allowed.
      read = Facet::Document::Read.call(db, "app", "App", proj.id, viewer)
      read.should be_a(Facet::Document::Read::Result)
    end
  end

  it "blocks an anonymous role (no permissions) from every operation" do
    with_db do |db|
      nobody = app_rbac_ctx("anon", [] of {String, String})

      result = Facet::Document::Create.call(db, "app", "App", app_rbac_body, nobody)
      expect_create_error(result, 403)
    end
  end
end

describe "app.App assistant fields (chat package)" do
  before_each do
    with_db { |db| seed_app_doctypes(db) }
  end

  it "round-trips assistant_enabled (default off) and assistant_prompt" do
    with_db do |db|
      slug, proj = create_app(db)

      # Absent fields read as the defaults: the flag off, no prompt.
      proj.content["assistant_enabled"].as_bool.should be_false
      proj.content["assistant_prompt"]?.should be_nil

      upd = expect_update_success(Facet::Document::Update.call(
        db, "app", "App", proj.id,
        %({"assistant_enabled": true, "assistant_prompt": "Answer about the CRM only."}),
        Facet::RBAC::AuthContext.system,
      ))
      upd.projection.content["assistant_enabled"].as_bool.should be_true
      upd.projection.content["assistant_prompt"].as_s.should eq("Answer about the CRM only.")

      slug.should_not be_empty
    end
  end

  it "allows assistant_enabled on a confidential app at create time" do
    with_db do |db|
      # Client type does not gate the assistant flag: a `confidential` app
      # has a backend component but signs in through the consent screen
      # like a `public` app, so its browser can host the chat.
      body = app_body("conf-assist-#{unique_suffix}", %({
        "client_type": "confidential",
        "assistant_enabled": true
      }))
      result = Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)
      proj = expect_create_success(result).projection
      proj.content["assistant_enabled"].as_bool.should be_true
    end
  end

  it "allows an update that enables the flag on a confidential app" do
    with_db do |db|
      body = app_body("conf-flag-#{unique_suffix}", %({"client_type": "confidential"}))
      proj = expect_create_success(
        Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)).projection

      upd = expect_update_success(Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"assistant_enabled": true}),
        Facet::RBAC::AuthContext.system,
      ))
      upd.projection.content["assistant_enabled"].as_bool.should be_true
    end
  end

  it "allows an update that flips a public app to confidential while the flag is on" do
    with_db do |db|
      body = app_body("flip-conf-#{unique_suffix}", %({"assistant_enabled": true}))
      proj = expect_create_success(
        Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)).projection

      upd = expect_update_success(Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"client_type": "confidential"}),
        Facet::RBAC::AuthContext.system,
      ))
      upd.projection.content["client_type"].as_s.should eq("confidential")
      upd.projection.content["assistant_enabled"].as_bool.should be_true
    end
  end

  it "allows a confidential app whose flag stays off" do
    with_db do |db|
      body = app_body("conf-off-#{unique_suffix}", %({"client_type": "confidential"}))
      proj = expect_create_success(
        Facet::Document::Create.call(db, "app", "App", body, Facet::RBAC::AuthContext.system)).projection

      upd = expect_update_success(Facet::Document::Update.call(
        db, "app", "App", proj.id, %({"name": "Backend App"}),
        Facet::RBAC::AuthContext.system,
      ))
      upd.projection.content["assistant_enabled"].as_bool.should be_false
    end
  end
end
