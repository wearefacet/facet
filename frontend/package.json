{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"license": "BUSL-1.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:error\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --compiler-warnings \"state_referenced_locally:error\"",
		"lint": "prettier --check . && eslint --max-warnings=0 .",
		"lint:eslint": "eslint --max-warnings=0 .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/sveltekit": "^10.4.6",
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/luaparse": "^0.2.13",
		"@types/node": "^22",
		"@vitest/browser": "^4.1.9",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"js-yaml": "^5.0.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.4.6",
		"storybook-dark-mode": "^5.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.3",
		"@codemirror/commands": "6.10.4",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/legacy-modes": "^6.5.3",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.1",
		"@codemirror/state": "6.7.0",
		"@codemirror/view": "6.43.2",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.21.0",
		"@milkdown/crepe": "^7.22.1",
