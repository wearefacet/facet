# Facet release stack — template for docker/.env (git-ignored).
#
# Copy: cp docker/.env.example docker/.env — then fill every value in.
# docker/compose.prod.yml reads this file for the Postgres credentials, the
# edge placement, and every secret the backend config expands. A missing
# value fails the boot loud at config load — that is the contract, never a
# silent default.
#
# FACET_REDIS_URL has no row here: compose points it at the redis service.

# ── PostgreSQL ────────────────────────────────────────────────────────────
#
# The password exists in exactly one place: compose interpolates it into the
# postgres service and into DATABASE_URL from this key. Keep it URL-safe —
# no : / @ ? # (it rides inside DATABASE_URL unescaped).
POSTGRES_DB=facet
POSTGRES_USER=facet
POSTGRES_PASSWORD=

# ── Edge (Caddy) ──────────────────────────────────────────────────────────
#
# FACET_HOSTNAME is the main vhost name; HTTPS_PORT is the TLS port Caddy
# binds and the stack publishes. The localhost topology keeps both defaults
# (internal-CA certificates; Chromium resolves *.localhost to loopback by
# itself; every other client needs one /etc/hosts line per host). A real
# domain sets its name, moves TLS to 443, and publishes port 80 for the
# ACME HTTP-01 challenge and the redirect:
#
#   FACET_HOSTNAME=facet.example.tld
#   HTTPS_PORT=443
#   CADDY_HTTP_PUBLISH=80:80
FACET_HOSTNAME=facet.localhost
HTTPS_PORT=3443
CADDY_HTTP_PUBLISH=127.0.0.1:18080:80

# ── Backend public origins ────────────────────────────────────────────────
#
# FACET_HOST / FACET_BASE_URL name the public main URL — they must agree
# with FACET_HOSTNAME + HTTPS_PORT above (discovery documents, OAuth
# redirects, and the reserved app-host set derive from them).
# FACET_ARTIFACT_BASE_URL is the artifact byte-streaming origin: browsers
# receive signed capability URLs there. The quick-start stack streams
# artifacts from the main host (/a/* routes to the backend); a serious
# install uses a dedicated origin (e.g. https://cdn.example.tld).
FACET_HOST=https://facet.localhost:3443
FACET_BASE_URL=https://facet.localhost:3443
FACET_ARTIFACT_BASE_URL=https://facet.localhost:3443

# ── Secrets ───────────────────────────────────────────────────────────────
#
# Generate each one with `openssl rand -base64 32`. Never reuse a value
# across environments.
FACET_ARTIFACT_GRANT_SECRET=
FACET_SECRETS_MASTER_KEY=

# ── Outbound email ────────────────────────────────────────────────────────
#
# Production refuses the dev mail adapter: password-reset, invite, and MFA
# links must reach users. Set a real SMTP relay here.
FACET_MAIL_FROM_ADDRESS=no-reply@facet.localhost
FACET_MAIL_FROM_NAME=Facet
FACET_SMTP_HOST=
FACET_SMTP_USERNAME=
FACET_SMTP_PASSWORD=
