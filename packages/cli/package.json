{
	"name": "@facetapp/cli",
	"version": "0.0.3",
	"description": "Command-line interface for Facet.",
	"license": "BUSL-1.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wearefacet/facet.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": {
		"facet-cli": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit",
		"dev": "node dist/index.js",
		"predev": "tsc",
		"start": "node dist/index.js",
		"prestart": "tsc",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"commander": "^15.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
