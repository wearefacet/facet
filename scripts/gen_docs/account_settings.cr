# Generates site-docs/src/content/docs/reference/account-settings-keys.md from
# the account settings registry (src/settings/keys.cr).
# Run: make gen-docs-account-settings
#
# Mechanism: requires the real registry (`src/settings/keys.cr`, which
# depends only on the JSON library) and reads `Settings::Keys::REGISTRY`,
# `SERVER_DEFAULTS`, and `ALLOWED_LANGUAGES` from the compiled code. Keys,
# kinds, and defaults come from the registry. The registry holds no purpose
# text, so the script declares one purpose line per key and fails loud when
# the registry and the purpose lines do not match exactly.

require "../../src/settings/keys"
require "./fr_overlay"

REPO_ROOT  = File.expand_path("../..", __DIR__)
PAGE_PATHS = {
  "en" => File.join(REPO_ROOT, "site-docs/src/content/docs/reference/account-settings-keys.md"),
  "fr" => File.join(REPO_ROOT, "site-docs/src/content/docs/fr/reference/account-settings-keys.md"),
}

private def verified_at : String
  output = IO::Memory.new
  errors = IO::Memory.new
  status = Process.run("git", ["rev-parse", "--short", "HEAD"],
    output: output, error: errors, chdir: REPO_ROOT)
  raise "git rev-parse failed: #{errors.to_s.strip}" unless status.success?
  output.to_s.strip
end

private def esc(text : String) : String
  text.gsub("|", "\\|")
end

# Purpose lines for registered keys, keyed by `app.key`. The registry holds
# no purpose text; a key without a line here fails the generation.
PURPOSES = {
  "core.timezone"                => "IANA timezone the account's dates and times render in.",
  "core.language"                => "Language code for the account's interface.",
  "core.pinned_doctypes"         => "Qualified doctype names the account pins to the top of the sidebar.",
  "core.pinned_collection_views" => "Collection views the account pins in doctype listings.",
  "core.show_welcome"            => "Replays the first-run welcome tour when true; the tour writes false when dismissed.",
  "notifications.in_app"         => "Gates the client-side notification delivery: bell, badge, and live subscription.",
}

private def generate : Nil
  registry = Facet::Settings::Keys::REGISTRY
  raise "Settings::Keys::REGISTRY is empty" if registry.empty?

  registered = registry.keys.map { |pair| "#{pair[0]}.#{pair[1]}" }.to_set
  declared = PURPOSES.keys.to_set
  missing = (registered - declared).to_a.sort
  extra = (declared - registered).to_a.sort
  unless missing.empty?
    raise "Registered keys with no purpose line: #{missing.join(", ")}"
  end
  unless extra.empty?
    raise "Purpose lines for unregistered keys: #{extra.join(", ")}"
  end

  languages = Facet::Settings::Keys::ALLOWED_LANGUAGES.to_a.sort.join(", ")

  rows = registered.to_a.sort.map do |path|
    pair = path.split(".", 2)
    descriptor = registry[{pair[0], pair[1]}]
    purpose = PURPOSES[path]
    if path == "core.language"
      purpose += " Allowed values: #{languages}."
    end
    "| `#{esc(path)}` | #{descriptor.kind.to_s.downcase} | #{esc(descriptor.default.to_json)} | #{esc(purpose)} |"
  end

  # The server-default chain: an account key with no row of its own follows
  # the named core.SystemSettings path (derived from SERVER_DEFAULTS).
  chain_en = Facet::Settings::Keys::SERVER_DEFAULTS.to_a.map do |pair, sys_path|
    "- `#{pair[0]}.#{pair[1]}` follows `#{sys_path}`."
  end.sort!

  ov = "account-settings-keys"
  en_body = <<-MARKDOWN
  ---
  title: Account settings keys
  description: Every account settings key with its type and default.
  audience: [operator, admin]
  features: [PLT-17]
  sidebar:
    order: 16
  verified_at: 008dd880
  ---

  > Generated from `src/settings/keys.cr` by `make gen-docs-account-settings`. Do not edit this file by hand.

  Use this page to find the key, its type, and its default. Account settings are
  per-account preferences. The service stores them as `(app, key)` pairs and
  refuses any pair this registry does not list.

  The table lists every registered key, its type, and its default.

  | Key | Type | Default | Purpose |
  |---|---|---|---|
  #{rows.join("\n")}

  Two keys carry a server tier before their registry default. An account with no
  value of its own follows the instance's system settings:

  #{chain_en.join("\n")}

  ## Related

  - [/workspace/settings-sessions-api-keys/](/workspace/settings-sessions-api-keys/)
  - [/operate/system-settings/](/operate/system-settings/)
  MARKDOWN

  fr_rows = registered.to_a.sort.map do |path|
    pair = path.split(".", 2)
    descriptor = registry[{pair[0], pair[1]}]
    purpose = GenDocs::FrOverlay.fetch(ov, "purpose_#{path.gsub(".", "_")}", PURPOSES[path])
    if path == "core.language"
      purpose += " Valeurs autorisées : #{languages}."
    end
    "| `#{esc(path)}` | #{descriptor.kind.to_s.downcase} | #{esc(descriptor.default.to_json)} | #{esc(purpose)} |"
  end

  fr_chain = Facet::Settings::Keys::SERVER_DEFAULTS.to_a.map do |pair, sys_path|
    "- `#{pair[0]}.#{pair[1]}` suit `#{sys_path}`."
  end.sort!

  fr_body = <<-MARKDOWN
  ---
  title: Clés de réglage de compte
  description: #{GenDocs::FrOverlay.fetch(ov, "description", "")}
  audience: [operator, admin]
  features: [PLT-17]
  sidebar:
    order: 16
  verified_at: 008dd880
  ---

  #{GenDocs::FrOverlay.fetch(ov, "generated_note", "")}

  #{GenDocs::FrOverlay.fetch(ov, "intro", "")}

  #{GenDocs::FrOverlay.fetch(ov, "table_intro", "")}

  | #{GenDocs::FrOverlay.fetch(ov, "col_key", "Key")} | #{GenDocs::FrOverlay.fetch(ov, "col_type", "Type")} | #{GenDocs::FrOverlay.fetch(ov, "col_default", "Default")} | #{GenDocs::FrOverlay.fetch(ov, "col_purpose", "Purpose")} |
  |---|---|---|---|
  #{fr_rows.join("\n")}

  #{GenDocs::FrOverlay.fetch(ov, "tier_note", "")}

  #{fr_chain.join("\n")}

  ## #{GenDocs::FrOverlay.fetch(ov, "related_heading", "Related")}

  #{GenDocs::FrOverlay.fetch(ov, "related_workspace", "")}
  #{GenDocs::FrOverlay.fetch(ov, "related_system_settings", "")}
  MARKDOWN

  {"en" => en_body, "fr" => fr_body}.each do |locale, text|
    path = PAGE_PATHS[locale]
    Dir.mkdir_p(File.dirname(path))
    File.write(path, text)
  end
  puts "wrote account-settings-keys.md in en + fr (#{registry.size} keys)"
end

generate
