#
# Generates site-docs/src/content/docs/reference/cli-facet.md from
# src/cli/commands.cr (the CLI command registry). Run: make gen-docs-cli
#
# Mechanism: the registry file drags in the whole application (database,
# migrations, IAM, HTTP server), so this script cannot `require` it and read
# the table as objects. It extracts the rows from the source text with one
# strict anchored pattern instead. Every `command(` row inside the registry
# array must match the pattern and the match count must equal the row count,
# so a renamed field, a new attribute, or a reformatted row stops the
# generation instead of silently dropping a command from the page.
#
# Columns: Command and Purpose come from the registry (`name`, `help`).
# Options comes from `takes_options`. The `help` cells stay verbatim English
# in both locales. The French page under fr/reference/ takes its prose from
# scripts/gen_docs/fr_overlay/cli-facet.json.

require "json"
require "./fr_overlay"

REPO_ROOT  = File.expand_path("../..", __DIR__)
SOURCE     = File.join(REPO_ROOT, "src", "cli", "commands.cr")
PAGE_PATHS = {
  "en" => File.join(REPO_ROOT, "site-docs", "src", "content", "docs", "reference", "cli-facet.md"),
  "fr" => File.join(REPO_ROOT, "site-docs", "src", "content", "docs", "fr", "reference", "cli-facet.md"),
}
# The commit where the page content was last verified; both locales pin it.
VERIFIED_AT = "008dd880"

record Row, name : String, help : String, takes_options : Bool

def fail!(message : String) : NoReturn
  abort "gen_docs/cli: #{message}"
end

# Unescapes the two-character escapes a Crystal string literal may carry in
# the help column (\", \\, \n, \t).
def unescape(literal : String) : String
  String.build do |io|
    i = 0
    while i < literal.size
      char = literal[i]
      if char == '\\' && i + 1 < literal.size
        next_char = literal[i + 1]
        io << case next_char
        when 'n' then '\n'
        when 't' then '\t'
        else          next_char
        end
        i += 2
      else
        io << char
        i += 1
      end
    end
  end
end

# Escapes the literal pipes that markdown table cells cannot carry raw.
def md_cell(text : String) : String
  text.gsub("|", "\\|")
end

source = File.read(SOURCE)

start_marker = "private def self.commands : Array(Entry)"
marker_pos = source.index(start_marker) || fail!("'#{start_marker}' not found in src/cli/commands.cr")
array_start = source.index('[', marker_pos + start_marker.size) || fail!("registry array not found in src/cli/commands.cr")
array_end = source.index("\n      ]\n", array_start) || fail!("end of the registry array not found in src/cli/commands.cr")
body = source[(array_start + 1)...array_end]

# Comment-only lines hold no registry rows; drop them so the completeness
# count below counts code lines only.
code_lines = body.each_line
  .reject { |line| line.strip.empty? || line.strip.starts_with?('#') }
  .to_a

# The full row shape: one line, name, quoted help, the takes_options flag,
# and the handler block the registry format always carries.
row_pattern = /^command\("([^"]+)", "((?:[^"\\]|\\.)*)", (true|false)\) do \|_*trailing\|$/

rows = [] of Row
unmatched = [] of String
code_lines.each do |line|
  stripped = line.strip
  next unless stripped.starts_with?("command(")
  match = row_pattern.match(stripped)
  if match
    rows << Row.new(
      name: match[1],
      help: unescape(match[2]),
      takes_options: match[3] == "true",
    )
  else
    unmatched << stripped
  end
end

occurrences = code_lines.count(&.includes?("command("))
unless unmatched.empty? && occurrences == rows.size
  fail!("registry rows do not match the expected shape:\n  #{unmatched.join("\n  ")}")
end
fail!("no command rows extracted from the registry") if rows.empty?

duplicates = rows.map(&.name).tally.select { |_, count| count > 1 }
unless duplicates.empty?
  fail!("duplicate command names: #{duplicates.keys.join(", ")}")
end

rows.sort_by!(&.name)

ov = "cli-facet"

en_rows = rows.map do |row|
  options = row.takes_options ? "consumes its own options" : "—"
  "| `#{row.name}` | #{md_cell(row.help)} | #{options} |"
end

fr_rows = rows.map do |row|
  options = row.takes_options ? GenDocs::FrOverlay.fetch(ov, "col_consumes_own", "consumes its own options") : "—"
  "| `#{row.name}` | #{md_cell(row.help)} | #{options} |"
end

en_page = <<-MARKDOWN
  ---
  title: facet CLI
  description: Every facet CLI command with its purpose and option handling.
  audience: [developer, operator]
  features: [PLT-11, IAM-12, DOM-18]
  type: reference
  sidebar:
    order: 2
  verified_at: #{VERIFIED_AT}
  ---

  > Generated from `src/cli/commands.cr` by `make gen-docs-cli`. Do not edit this file by hand.

  A maintainer runs one-off tasks on a running instance: reset a dev database, seed an admin, pin the auth mode, re-project a doctype. The table lists every `facet` command with its purpose and how it handles options. The L2 page [Bootstrapping](/admin/install/bootstrap/) explains the bootstrap flow these commands drive.

  One `facet` call can run several commands in a row: `facet db_reset --yes seed:dev`.
  A command that consumes its own options reads every following token as its option.
  Such a command must be last in a chain.
  Every other command takes only its dash options, and the chain continues after them.
  `server` is the default command and starts the HTTP server.

  | Command | Purpose | Options |
  |---|---|---|
  #{en_rows.join("\n")}

  ## Related

  - [Bootstrap and CLI tasks](/admin/install/bootstrap/)
  - [Quickstart with the dev CLI](/build/apps/quickstart/)
  MARKDOWN

fr_page = <<-MARKDOWN
  ---
  title: CLI facet
  description: #{GenDocs::FrOverlay.fetch(ov, "description", "")}
  audience: [developer, operator]
  features: [PLT-11, IAM-12, DOM-18]
  type: reference
  sidebar:
    order: 2
  verified_at: #{VERIFIED_AT}
  ---

  #{GenDocs::FrOverlay.fetch(ov, "generated_note", "")}

  #{GenDocs::FrOverlay.fetch(ov, "intro", "")}

  #{GenDocs::FrOverlay.fetch(ov, "chain_intro", "")}

  | #{GenDocs::FrOverlay.fetch(ov, "col_command", "Command")} | #{GenDocs::FrOverlay.fetch(ov, "col_purpose", "Purpose")} | #{GenDocs::FrOverlay.fetch(ov, "col_options", "Options")} |
  |---|---|---|
  #{fr_rows.join("\n")}

  ## #{GenDocs::FrOverlay.fetch(ov, "related_heading", "Related")}

  #{GenDocs::FrOverlay.fetch(ov, "related_bootstrap", "")}
  #{GenDocs::FrOverlay.fetch(ov, "related_quickstart", "")}
  MARKDOWN

pages = {"en" => en_page, "fr" => fr_page}

pages.each do |locale, text|
  path = PAGE_PATHS[locale]
  # The heredoc drops the final newline; the pages end with one.
  Dir.mkdir_p(File.dirname(path))
  File.write(path, text + "\n")
end
puts "gen_docs/cli: wrote reference/cli-facet.md + fr twin (#{rows.size} commands)"
