require "json"
require "pg"
require "../database"
require "../mutation/client"
require "../util/script_helpers"
require "../rbac"
require "../error"
require "../document/projection_gucs"
require "./copy"
require "./editors"
require "../doctype/definition_error"
require "../doctype/definition_store"

module Facet
  module Domain
    # Creates draft domains.
    #
    # A draft domain is a `core.Domain` document with `draft = true` and an
    # autogenerated `_`-prefixed unique name. Once created, doctypes can be
    # freely registered/rewritten against it (see `Doctype::Update`'s
    # draft-mode branch). See `doc/backend/draft-domains.md`.
    #
    # The `_` prefix is **cosmetic only** — every guard, filter, and branch
    # keys off the `draft = true` boolean, never off the prefix. The prefix
    # exists solely to give drafts a globally-unique namespace that cannot
    # collide with any live domain name (which must start with `[a-z]`).
    #
    # Two creation modes:
    #
    # - `.create` — empty draft. A new `core.Domain` document with `draft: true`
    #   and no doctypes. Used for the "New domain from scratch" action.
    # - `.create_from` — structure-copy draft. Copies a live domain's
    #   structure (doctype definitions + domain document) into a new draft via
    #   `Domain::Copy.structure`, stamping a `source_domain` provenance field
    #   on the new draft so the "one draft per source domain" invariant can be
    #   enforced. No document data is copied. Used for the "Edit existing
    #   domain" action.
    module Draft
      record Result,
        projection : Mutation::Client::Projection,
        mutation_id : String

      # Creates a new, empty draft domain document.
      #
      # `body` is the (optional, `{}` if absent) JSON content for the domain
      # document — e.g. `{"description": "…", "color": "#…"}`. Any `draft`
      # or `id` field in the body is overwritten (the caller cannot pick the
      # name or escape draft mode). `actioner_id` is the actor creating the
      # draft.
      def self.create(
        db : DB::Connection,
        body : String,
        actioner_id : String,
      ) : Result | Facet::ServiceError
        # Parse the body (or default to empty), strip any attempt to set
        # `draft` or `id`/`domain` — the system owns those. A present body
        # that is not a JSON object answers 422 (B-59) — silently coercing
        # it to `{}` would create a draft the caller did not ask for.
        parsed = begin
          JSON.parse(body)
        rescue ex : JSON::ParseException
          return Facet::ServiceError.new(422, "Invalid JSON body: #{ex.message}")
        end

        content_h = parsed.as_h?
        unless content_h
          return Facet::ServiceError.new(
            422,
            "Body must be a JSON object (got #{Doctype::StrictKeys.json_kind(parsed)})"
          )
        end
        content_h.delete("draft")
        content_h.delete("id")
        content_h.delete("domain")
        content_h["draft"] = JSON::Any.new(true)

        # Authoring-time field checks (B-307): the draft door writes through
        # `Mutation::Client` directly, so no field validation sees the body.
        # `name` is the publish-target id and `label` the display name — a
        # value the update door would reject must not land on the draft.
        # Validate both against the definition, the same check a later PATCH
        # applies. Skipped when the definition is not registered (nothing to
        # check against); publish still validates the live target name.
        ["name", "label"].each do |key|
          if value = content_h[key]?
            if field_error = validate_draft_field(db, key, value)
              return field_error
            end
          end
        end

        draft_name = generate_name(db)
        return Facet::ServiceError.new(409, "Generated draft name '#{draft_name}' already exists — retry") if draft_name.nil?

        content = JSON::Any.new(content_h)

        # Wrap the mutation insert + projection fetch in a transaction so the
        # transaction-local GUCs (set or implicit) survive. No-op when the
        # caller already holds a transaction.
        mut_id, projection = Database.with_transaction(db, ignore_if_set: true) do |txn|
          # core.Domain has no parseable definition — stage the empty GUC
          # set, the same branch Document::Create uses for domain creates.
          Document::ProjectionGucs.clear_all(txn)

          this_mut_id = Mutation::Client.create(
            txn,
            "core", "Domain",
            doc_id: draft_name,
            content: content.to_json,
            actioner_id: actioner_id,
          )
          this_proj = Mutation::Client.fetch_projection(txn, "core", "Domain", draft_name)
          # The creator of a draft becomes its domain editor. Same
          # transaction — the grant dies with the draft if it fails.
          Editors.grant(txn, draft_name, actioner_id, actioner_id)
          {this_mut_id, this_proj}
        end

        Event::Publisher.enqueue(
          domain: "core", doc_type: "Domain", doc_id: draft_name,
          event: "created", mutation_id: mut_id, actioner_id: actioner_id,
        )

        Result.new(projection: projection, mutation_id: mut_id)
      end

      # Creates a draft domain from an existing **live** domain by copying its
      # structure (doctype definitions + `core.Domain` document) into a new
      # draft. No document data is copied — only the schema.
      #
      # `auth_context` gates the fork: the caller must be a domain editor of
      # the source domain (`Domain::Editors.authorize_draft_from?`, 403
      # otherwise). A blanket `create core.Domain` grant (the seeded
      # `editor` role) does not relax this — a draft forks the source's
      # definition surface. Only the system bypass passes. Internal callers
      # default to the system bypass — the same convention
      # `Domain::Publish.call` uses; the HTTP route passes the caller's real
      # context.
      #
      # Stamps a `source_domain` field on the new draft's `core.Domain`
      # document so the "one draft per source domain" invariant is
      # enforceable: `.create_from` rejects with 409 if a draft with
      # `source_domain = source_id` already exists.
      #
      # Rejects with 422 if the source is missing or is itself a draft
      # (drafts are scratch — forking a draft into another draft is not
      # meaningful).
      def self.create_from(
        db : DB::Connection,
        source_id : String,
        actioner_id : String,
        auth_context : RBAC::AuthContext = RBAC::AuthContext.system,
      ) : Result | Facet::ServiceError
        # 0. Domain-membership gate. The permission scopes are presence-only
        #    at create time (no row exists), so membership of the source
        #    domain is checked here — whatever the create verdict. The system
        #    bypass passes; a preview principal and a denied caller fail
        #    closed.
        unless Editors.authorize_draft_from?(db, source_id, auth_context)
          return Facet::ServiceError.new(403, "Forbidden")
        end

        # 1. Load + validate the source domain projection.
        source = db.query_one?(
          <<-SQL,
            SELECT content FROM projections
            WHERE domain = 'core' AND doc_type = 'Domain' AND id = $1
              AND deleted_at IS NULL
          SQL
          source_id,
        ) do |rs|
          rs.read(JSON::Any)
        end

        return Facet::ServiceError.new(422, "Source domain '#{source_id}' not found") if source.nil?

        source_h = source.as_h?
        return Facet::ServiceError.new(422, "Source domain '#{source_id}' has invalid content") if source_h.nil?

        if source_h["draft"]?.try(&.raw) == true
          return Facet::ServiceError.new(422, "Cannot draft from a draft domain")
        end

        # 2. Enforce one-draft-per-source-domain: reject if a draft with this
        #    source_domain already exists.
        existing = db.query_one?(
          "SELECT 1 FROM projections WHERE domain = 'core' AND doc_type = 'Domain' " \
          "AND content->>'source_domain' = $1 AND content->>'draft' = 'true' " \
          "AND deleted_at IS NULL",
          source_id,
          as: Int32,
        )
        return Facet::ServiceError.new(409, "A draft already exists for domain '#{source_id}'") if existing

        # 3. Generate the draft name.
        draft_name = generate_name(db)
        return Facet::ServiceError.new(409, "Generated draft name '#{draft_name}' already exists — retry") if draft_name.nil?

        # 4. Copy structure (doctype definitions + domain document) into the
        #    new draft, stamping `source_domain` via `extra_content`.
        Database.with_transaction(db, ignore_if_set: true) do |txn|
          Copy.structure(
            txn,
            from: source_id,
            to: draft_name,
            draft: true,
            actioner_id: actioner_id,
            extra_content: {"source_domain" => JSON::Any.new(source_id)},
          )
          # The creator of a draft becomes its domain editor. Same
          # transaction — the grant dies with the draft if it fails.
          Editors.grant(txn, draft_name, actioner_id, actioner_id)
        end

        # 5. Fetch + return the new draft projection. The mutation id for the
        #    new domain document is not surfaced by `Copy.structure` (which
        #    returns `Nil`); the route returns the projection as the canonical
        #    representation.
        projection = Mutation::Client.fetch_projection(db, "core", "Domain", draft_name)
        Result.new(projection: projection, mutation_id: projection.id)
      end

      # ── Private ──────────────────────────────────────────────────────

      # Validates one draft body field against the `core.Domain` definition's
      # field of the same key (type, length, pattern). Returns the
      # `ServiceError` to surface, or `nil` when the value passes or no
      # definition is registered.
      private def self.validate_draft_field(
        db : DB::Connection,
        key : String,
        value : JSON::Any,
      ) : Facet::ServiceError?
        defn = Doctype::DefinitionStore.fetch(db, "core.Domain")
        return nil if defn.nil?

        field = defn.fields[key]?
        field_type = field.try(&.type)
        return nil if field.nil? || field_type.nil?

        errors = [] of ValidationError
        field_type.validate(value, field, key, errors)
        return nil if errors.empty?

        Facet::ServiceError.new(422, "Document validation failed", details: errors)
      end

      # Generates a `_`-prefixed unique name. Returns `nil` if the generated
      # name already exists (vanishingly improbable — the caller retries or
      # surfaces the conflict).
      #
      # Shared by `.create` (empty drafts) and `.create_from` (structure-copy
      # drafts) so both modes use the same naming scheme and collision check.
      private def self.generate_name(db : DB::Connection) : String?
        # ULID is time-sortable and plenty for uniqueness; the leading `_`
        # reserves the namespace. Lowercased so the result satisfies the
        # doctype `domain` regex (`_?[a-z0-9][a-z0-9_]*`) — ULID's Crockford
        # base32 is uppercase.
        draft_name = "_#{Util::ScriptHelpers.ulid[0..11].downcase}"

        # Defensive: if the name somehow collides, surface nil so the caller
        # can signal the retry rather than overwrite a live domain.
        existing = db.query_one?(
          "SELECT 1 FROM projections WHERE domain = 'core' AND doc_type = 'Domain' AND id = $1",
          draft_name,
          as: Int32,
        )
        return nil if existing

        draft_name
      end
    end
  end
end
