module Facet
  module Doctype
    # Service for reconciling the core doctype seed corpus with the
    # database.
    #
    # After migrations run, core doctypes (those that define the schema
    # system itself — e.g. `core.DocType`, `core.Domain`) must exist in
    # the database so that the application can bootstrap itself. This
    # module reads the embedded seed corpus (`SEED_FILES`, baked at compile
    # time from `data/seeds/`) and reconciles it with the stored rows:
    #
    # - a definition missing from the database is created (raw insert —
    #   the bootstrap path, where the definition store is still empty);
    # - a definition that drifted from its seed file is updated. Seeds the
    #   authoring gate accepts go through the real schema-evolution
    #   pipeline (`Doctype::Update` — version gates, validation, diff
    #   persist, index sync, events); the bootstrap definitions that can
    #   never pass their own gate (`core.DocType`, `core.Domain`,
    #   `core.DomainGrant`) are written raw, mirroring the create path.
    #   A seed file whose `schema_version` is bumped with a `migrations`
    #   map is an automated system-doctype migration: the next server
    #   start applies it. The seed corpus is the source of truth — an
    #   administrator edit of a system definition is reverted to the seed
    #   on the next boot;
    # - missing seed documents are created through the real document
    #   pipeline. Existing seed documents are never rewritten — users may
    #   have edited them.
    #
    # ### Seed directory format
    #
    # Each subdirectory under `data/seeds/` is named `{domain}.{Doctype}`
    # and contains:
    #
    # - `definition.json` — the doctype definition (required)
    # - `script.lua` — optional Lua script, injected into the definition
    # - `documents.json` — optional array of initial documents to create
    #
    # Seeding runs in two passes. Pass one registers every definition
    # (alphabetically); pass two seeds the seed documents of every
    # directory that carries a documents file. The split guarantees a seed
    # document's reference targets are registered regardless of
    # alphabetical order, and lets seed
    # documents go through the real document pipeline (`Document::Create`) —
    # validation, lifecycle hooks (e.g. `app.App`'s autogenerated
    # `client_id`), display names — instead of raw mutation rows.
    module Seed
      # Embedded seed corpus, keyed by `"{dir}/{filename}"` relative to
      # `data/seeds/`. Filled at compile time — the directory stays the
      # source of truth, and a changed seed file requires a rebuild (the
      # Makefile tracks the files as build dependencies).
      SEED_FILES = {% begin %}
        {% files = `find #{__DIR__}/../../data/seeds -type f | sed "s|^#{__DIR__}/../../data/seeds/||" | LC_ALL=C sort`.lines.reject(&.empty?) %}
        {% raise "Doctype::Seed: no data/seeds files found at compile time" if files.empty? %}
        {
          {% for file in files %}
            {{ file }} => {{ read_file("#{__DIR__}/../../data/seeds/#{file.id}") }},
          {% end %}
        }
      {% end %}

      private DEFINITION_FILE_NAMES = %w[definition.yaml definition.yml definition.json]
      private DOCUMENTS_FILE_NAMES  = %w[documents.yaml documents.yml documents.json]

      # Seed directory names that carry a definition file, sorted — the
      # directories `seed` registers.
      private SEED_DIRS = SEED_FILES.keys.select do |key|
        parts = key.split("/")
        parts.size == 2 && DEFINITION_FILE_NAMES.includes?(parts[1])
      end.map(&.split("/").first).uniq!.sort!

      # Definition directories that must seed before every sibling. Each
      # definition row stages its derived columns from the stored
      # `core.DocType` definition, so the system definition seeds first
      # (mirrors the pass-two `DOCUMENT_SEED_HOIST`).
      private DEFINITION_SEED_HOIST = ["core.DocType"]

      # Directories whose seed *documents* are skipped. Definitions still
      # seed — only the bulky per-document pass is cut. Empty by default
      # (the full corpus); the test suite pins `core.Currency` here: money
      # validation reads the in-memory registry (`Util::Currency`, fed by
      # `register_seed_currencies`), and re-creating ~160 currency
      # documents through the full pipeline on every re-seed dominated the
      # suite's per-example cost.
      class_property document_exclusions : Array(String) = [] of String

      # Outcome of one `seed` run — the qualified doctype ids touched by
      # the definition pass, split by what happened to them.
      record Report,
        created : Array(String),
        updated : Array(String) do
        # True when the database already matched the seed corpus.
        def empty? : Bool
          created.empty? && updated.empty?
        end
      end

      # Session advisory lock that serializes the reconcile across server
      # instances booting against one database. Keyed the same way as the
      # document-sequence lock (`Document::SequenceId`) — `String#hash`
      # is stable across processes.
      RECONCILE_LOCK_KEY = "seed:reconcile".hash.to_i64!

      # How long a boot waits for the reconcile lock before it skips the
      # pass: the lock holder is running the same reconcile, so the skip
      # is safe. Test-suite examples pin this down to keep the skip spec
      # fast.
      class_property reconcile_lock_timeout : Time::Span = 30.seconds

      # Seeds the complete corpus — every definition and every seed
      # document, whatever `document_exclusions` holds. The production
      # bootstrap commands (`Migrate.seed_core`, `Migrate.db_reset`, the
      # server boot reconcile) run through this: their contract is a full
      # baseline (the currency registry hydrates from the seeded rows), so
      # a process-level exclusion set by an embedder must never narrow
      # the CLI seed.
      def self.seed_full(db : DB::Connection) : Report
        previous = document_exclusions
        self.document_exclusions = [] of String
        seed(db)
      ensure
        self.document_exclusions = previous || [] of String
      end

      # Reconciles the embedded seed corpus with the database (see the
      # module comment for the per-pass semantics). Returns a `Report`
      # with the definitions created and updated.
      #
      # Serialized across concurrent boots with a Postgres advisory lock
      # (`RECONCILE_LOCK_KEY`). A boot that cannot take the lock within
      # `reconcile_lock_timeout` skips the pass — the lock holder is
      # running the same reconcile. The lock is the polling form
      # (`pg_try_advisory_lock`), never the blocking one: a session queued
      # on the blocking lock sits inside an open transaction and can
      # deadlock a concurrent `CREATE INDEX CONCURRENTLY` (B-46, see
      # `Index::Manager`).
      def self.seed(db : DB::Connection) : Report
        locked = acquire_reconcile_lock(db)
        unless locked
          Log.for("facet.doctype.seed").warn { "reconcile lock busy — another instance is seeding, skipping" }
          return Report.new([] of String, [] of String)
        end
        reconcile(db)
      ensure
        release_reconcile_lock(db) if locked
      end

      # The lock-guarded reconcile body.
      private def self.reconcile(db : DB::Connection) : Report
        dirs = SEED_DIRS.sort_by { |dir| {DEFINITION_SEED_HOIST.includes?(dir) ? 0 : 1, dir} }

        created = [] of String
        updated = [] of String

        # Pass one: definitions — create the missing ones, update the ones
        # that drifted from their seed file.
        dirs.each do |dir|
          domain, doctype = parse_dir_name(dir)
          next if domain.nil? || doctype.nil?

          doctype_id = "#{domain}.#{doctype}"
          if doctype_exists?(db, doctype_id)
            apply_definition_update(db, dir, doctype_id).try { |id| updated << id }
          else
            seed_definition(db, dir, domain, doctype).try { |id| created << id }
          end
        end

        # Pass two: documents of every seed directory with a documents
        # file — not only the ones pass one just created, so new seed
        # documents reach existing databases too. Per-document idempotency
        # (`seed_dir_documents`) keeps this safe on a seeded database.
        seed_document_directories(db, dirs)

        # Third pass: ensure every live doctype has its default general
        # "All Records" `core.CollectionView` child. This runs *after* the
        # first pass so `core.CollectionView`'s own doctype definition is
        # registered before any view is created. Idempotent — skips
        # doctypes that already have at least one live view child.
        seed_default_collection_views(db)

        Report.new(created, updated)
      end

      # Takes the session advisory lock, polling until granted or timed
      # out. Must be released on the same connection (`seed`'s ensure).
      private def self.acquire_reconcile_lock(db : DB::Connection) : Bool
        deadline = Time.instant + reconcile_lock_timeout
        loop do
          granted = db.query_one("SELECT pg_try_advisory_lock($1)", RECONCILE_LOCK_KEY, as: Bool)
          return true if granted
          return false if Time.instant >= deadline
          sleep 100.milliseconds
        end
      end

      private def self.release_reconcile_lock(db : DB::Connection) : Nil
        db.exec("SELECT pg_advisory_unlock($1)", RECONCILE_LOCK_KEY)
      rescue e : DB::Error
        # A dead connection releases its session locks by itself.
        Log.for("facet.doctype.seed").debug { "reconcile lock release skipped: #{e.message}" }
      end

      # Seeds one doctype definition directory when its `core.DocType`
      # document is missing. Unlike `ensure_doctype`, it never seeds the
      # directory's documents — use it when only the definition must exist
      # (e.g. a reference-target check that needs the doctype registered
      # while the spec seeds its own rows). Returns true when the
      # definition was created, false when it already existed (or the
      # directory has no definition file).
      def self.ensure_doctype_definition(db : DB::Connection, domain : String, doctype : String) : Bool
        seed_definition(db, "#{domain}.#{doctype}", domain, doctype) != nil
      end

      # Seeds one doctype definition directory when its `core.DocType`
      # document is missing, then seeds its `documents.yml` when the
      # definition was created. Idempotent. Unlike `seed`, it touches
      # nothing else — no other definitions and no other doctype's seed
      # documents. Returns true when the definition was created, false
      # when it already existed (or the directory has no definition file).
      def self.ensure_doctype(db : DB::Connection, domain : String, doctype : String) : Bool
        dir = "#{domain}.#{doctype}"
        return false unless seed_definition(db, dir, domain, doctype)

        documents_path = documents_file(dir)
        if documents_path && !document_exclusions.includes?(dir)
          seed_dir_documents(db, domain, doctype, documents_path)
        end
        true
      end

      # Seeds a single directory's definition (documents are seeded in the
      # second pass). Returns the doctype id when the definition was
      # created, nil when it already existed.
      private def self.seed_definition(
        db : DB::Connection,
        dir : String,
        domain : String,
        doctype : String,
      ) : String?
        doctype_id = "#{domain}.#{doctype}"

        # Idempotent: skip if the core doctype already exists. An existing
        # definition is reconciled by `apply_definition_update`, never by
        # this raw insert.
        return nil if doctype_exists?(db, doctype_id)

        content = canonical_definition(dir)
        return nil if content.nil?

        # Create the doctype definition document.
        # All doctype definitions are stored as core.DocType documents so that
        # DefinitionStore.fetch can find them by qualified doctype ID.
        #
        # Wrapped in a transaction per the service contract (any mutation must
        # be transactional). `ignore_if_set: true` lets an outer caller wrap a
        # batch of seeds in one transaction if desired.
        #
        # DocType is a child of Domain; parent_id is the domain name (the
        # core.Domain document's id).
        meta = %({"parent_id": #{domain.to_json}})

        # The row's derived columns (`search`, `links`, `display_name`) are
        # staged by the write pipeline as transaction-local GUCs the
        # projection trigger reads; an unstaged GUC stores NULL and the row
        # silently matches nothing (B-78: the picker's `filters[search]` tap
        # is the rendered corpus column, not the definition template).
        # Definition seeds bypass the pipeline, so they stage here. The
        # templates come from the stored `core.DocType` definition — the
        # doctype every definition row is written under — never from the
        # definition being seeded: rendering e.g. `crm.Deal`'s
        # `{{ title }} {{ value }}` against definition content stores NULL,
        # and `iam.Account`'s stores a literal template fragment. The parsed
        # seed doubles as the template source for the `core.DocType` seed
        # alone — that row is written before its definition exists in the
        # store, and there the two definitions coincide. (The definition
        # pass hoists `core.DocType` ahead of every sibling, so no other
        # row reaches the fallback.)
        parsed_content = JSON.parse(content)
        seed_defn = begin
          Doctype::DoctypeDefinition.from_json(content)
        rescue ArgumentError
          nil
        end
        fallback_defn = doctype_id == "core.DocType" ? seed_defn : nil

        Database.with_transaction(db, ignore_if_set: true) do |txn|
          stage_projection_gucs(txn, "core.DocType", parsed_content, fallback_defn)
          Mutation::Client.create(
            txn,
            "core",
            "DocType",
            doc_id: doctype_id,
            content: content,
            meta: meta,
            actioner_id: "system",
            cause: Mutation::Cause.root(Mutation::CauseKind::Seed),
          )
        end

        # The raw insert bypasses the document pipeline, so the definition
        # cache can hold a stale miss from before the create — drop it.
        DefinitionStore.invalidate(doctype_id)

        # Sync indexes when the seeded content parses as a definition.
        sync_seed_indexes(db, content)

        doctype_id
      end

      # Syncs indexes for a seed definition's content. Unparseable seeds
      # (e.g. `core.Domain`'s `any` field type) carry no indexable shape —
      # skipped, the same fallback the create path has always taken.
      private def self.sync_seed_indexes(db : DB::Connection, content : String) : Nil
        defn = Doctype::DoctypeDefinition.from_json(content)
        Index::Manager.sync(db, defn)
      rescue ArgumentError
        # Not a doctype definition — skip index sync
      end

      # Applies one seed directory's definition to an existing doctype.
      # Returns the doctype id when an update applied, nil when the stored
      # definition already matches the seed. Any failure is a seed bug —
      # raise, never skip silently.
      #
      # Two write paths, picked by the gate-exemption list below:
      #
      # - Gate-clean seeds go through `Doctype::Update` — the same pipeline
      #   an API PUT takes: version gates, validation, diff persist, index
      #   sync, events. This is the automated migration path for system
      #   doctypes: bump the seed file's `schema_version` with a
      #   `migrations` map, and the next server start applies it. No
      #   `$force`: the seed corpus must evolve the same way API-authored
      #   definitions do, so a destructive same-version seed edit fails
      #   the boot loudly instead of silently rewriting documents.
      # - Gate-exempt seeds predate the authoring gate and can never pass
      #   it (they carry reserved fields, unregistered field types, or
      #   actions served without a script). Their reconcile writes the
      #   canonical content raw, mirroring the create path.
      private def self.apply_definition_update(
        db : DB::Connection,
        dir : String,
        doctype_id : String,
      ) : String?
        content = canonical_definition(dir)
        return nil if content.nil?

        if GATE_EXEMPT_SEEDS.includes?(doctype_id)
          apply_raw_definition_update(db, doctype_id, content)
        else
          apply_pipeline_definition_update(db, doctype_id, content)
        end
      end

      # The seeds the authoring gate can never accept — they predate the
      # gate and carry shapes it rejects by design: `core.DocType` declares
      # the reserved `search` / `display_name` fields so the GET mask keeps
      # them, and computed fields with no script; `core.Domain` uses the
      # unregistered `any` field type; `core.DomainGrant` declares actions
      # served by dedicated routes with no script (B-299). The create path
      # bypasses the gate for the same reason, and `seed_validity_spec`
      # carries the same exemption list — keep the two lists in step.
      private GATE_EXEMPT_SEEDS = ["core.DocType", "core.Domain", "core.DomainGrant"]

      # The `Doctype::Update` write path for gate-clean seeds.
      private def self.apply_pipeline_definition_update(
        db : DB::Connection,
        doctype_id : String,
        content : String,
      ) : String?
        stored = db.query_one?("SELECT content FROM projections WHERE domain = 'core' AND doc_type = 'DocType' AND id = $1", doctype_id, as: JSON::Any)
        return nil if stored.nil?
        return nil if struct_equal?(stored, content)

        result = Doctype::Update.call(
          db,
          doctype_id,
          reconcile_body(db, doctype_id, content),
          RBAC::AuthContext.system,
          cause: Mutation::Cause.root(Mutation::CauseKind::Seed),
        )
        # A no-op re-save answers `200` with the unchanged projection
        # (`Result#unchanged`): the stored definition already matches the
        # seed, so this is not an update to report.
        if result.is_a?(Doctype::Update::Result)
          return result.unchanged ? nil : doctype_id
        end

        error = result.as(Facet::ServiceError)
        detail = error.details.try(&.map(&.message).join("; "))
        raise "Seed update for #{doctype_id} failed: #{error.message}#{detail ? " (#{detail})" : ""}"
      end

      # True when the stored definition and the seed content are the same
      # definition once both parse through `DoctypeDefinition` — the form
      # the pipeline persists. A stored row seeded before the struct
      # canonicalization and the authored seed shape differ in JSON-level
      # noise (default booleans, enum value objects) the struct normalizes
      # away; the no-op decision must not see that noise, or every boot
      # would rewrite every definition.
      private def self.struct_equal?(stored : JSON::Any, content : String) : Bool
        stored_form = Doctype::DoctypeDefinition.from_json(stored).to_json
        seed_form = Doctype::DoctypeDefinition.from_json(content).to_json
        stored_form == seed_form
      rescue ArgumentError
        false
      end

      # The raw write path for gate-exempt seeds — the update mirror of the
      # create path: a JSON diff of stored vs canonical content, the
      # projection GUCs staged from the stored `core.DocType` templates,
      # one mutation, cache invalidate, index sync, and the `updated`
      # fanout event. No authoring gate (the seed is the trusted
      # bootstrap), but a stored schema_version ahead of the seed still
      # fails loudly — the seed never silently downgrades a definition.
      private def self.apply_raw_definition_update(
        db : DB::Connection,
        doctype_id : String,
        content : String,
      ) : String?
        guard_version_not_downgrade(db, doctype_id, content)

        stored = db.query_one?("SELECT content FROM projections WHERE domain = 'core' AND doc_type = 'DocType' AND id = $1", doctype_id, as: JSON::Any)
        return nil if stored.nil?

        diff = Mutation::JsonDiff.diff(stored, JSON.parse(content))
        return nil if diff.set.empty? && diff.unset.empty?

        parsed_content = JSON.parse(content)
        mut_id = Database.with_transaction(db, ignore_if_set: true) do |txn|
          stage_projection_gucs(txn, "core.DocType", parsed_content, nil)
          Mutation::Client.update(
            txn,
            "core",
            "DocType",
            doctype_id,
            diff_json: diff.to_json,
            actioner_id: "system",
            cause: Mutation::Cause.root(Mutation::CauseKind::Seed),
          )
        end

        # The raw write bypasses the document pipeline — drop any cached
        # definition, sync indexes when the content parses as one, and
        # fan the `updated` event out (cache subscribers, replication and
        # hooks registries react to it).
        DefinitionStore.invalidate(doctype_id)
        sync_seed_indexes(db, content)
        Event::Publisher.enqueue(
          domain: "core",
          doc_type: "DocType",
          doc_id: doctype_id,
          event: "updated",
          mutation_id: mut_id,
          actioner_id: "system",
        )

        doctype_id
      end

      # Rejects a seed whose schema_version is below the stored one — the
      # raw path carries no version gate, so this is its loud downgrade
      # check (the pipeline path gets the same guard from
      # `Doctype::Update`).
      private def self.guard_version_not_downgrade(db : DB::Connection, doctype_id : String, content : String) : Nil
        seed_version = JSON.parse(content)["schema_version"]?.try(&.as_i?) || 1
        stored_version = stored_schema_version(db, doctype_id)
        if seed_version < stored_version
          raise "Seed update for #{doctype_id} failed: schema_version cannot decrease (stored: #{stored_version}, seed: #{seed_version})"
        end
      end

      private def self.stored_schema_version(db : DB::Connection, doctype_id : String) : Int32
        db.query_one?("SELECT (content->>'schema_version')::int FROM projections WHERE domain = 'core' AND doc_type = 'DocType' AND id = $1", doctype_id, as: Int32) || 1
      end

      # Strips the `migrations` map from a same-version seed body. The PUT
      # contract reserves `migrations` for breaking bumps: a body at the
      # stored version must declare none, and the update merges the stored
      # map back (B-301). The seed file still carries the map — a fresh
      # database needs it — so the reconcile body drops it only when the
      # stored version matches. At a version bump the map rides through
      # and lands the new gap entry; at a stored-ahead mismatch it rides
      # too and the version gate answers the loud failure.
      private def self.reconcile_body(db : DB::Connection, doctype_id : String, content : String) : String
        parsed = JSON.parse(content)
        seed_version = parsed["schema_version"]?.try(&.as_i?) || 1

        return content if seed_version != stored_schema_version(db, doctype_id)

        body = parsed.as_h
        return content unless body.has_key?("migrations")

        stripped = body.dup
        stripped.delete("migrations")
        stripped.to_json
      end

      # Second pass: seeds the `documents.yml` of every seed directory —
      # not only the doctypes the definition pass just created, so seed
      # documents added in a release reach already-seeded databases too.
      # Directories whose documents are reference targets of other seeds
      # run first — roles are the common reference target of seed
      # documents, so `iam.Roles` runs ahead of the alphabetical order and
      # a seed document's role reference resolves no matter which other
      # seed gains one.
      DOCUMENT_SEED_HOIST = ["iam.Roles"]

      private def self.seed_document_directories(
        db : DB::Connection,
        dirs : Array(String),
      ) : Nil
        dirs.select do |dir|
          !documents_file(dir).nil?
        end.sort_by! do |dir|
          {DOCUMENT_SEED_HOIST.includes?(dir) ? 0 : 1, dir}
        end.reject do |dir|
          document_exclusions.includes?(dir)
        end.each do |dir|
          domain, doctype = parse_dir_name(dir)
          next if domain.nil? || doctype.nil?

          documents_path = documents_file(dir)
          seed_dir_documents(db, domain, doctype, documents_path) if documents_path
        end
      end

      # Seeds initial documents from a documents.json file.
      #
      # Each document goes through the real create pipeline
      # (`Document::Create`): validation, normalization, lifecycle hooks
      # (e.g. `app.App`'s create hook assigns `client_id`), display names,
      # and computed fields. The system principal writes with
      # `skip_authorization` — the seed pass is the trusted bootstrap. A
      # failure aborts loudly: a seed document that cannot pass the same
      # rules as API-authored documents is a seed bug, never a silent gap.
      private def self.seed_dir_documents(
        db : DB::Connection,
        domain : String,
        doctype : String,
        documents_path : String,
      ) : Nil
        docs = JSON.parse(parse_content(documents_path)).as_a
        docs.each do |doc|
          doc_id = doc["id"].as_s

          # Per-document idempotency: a row created by another path (e.g. a
          # spec helper that seeded roles before `ensure_doctype`) must not
          # collide with the seed — skip it, never duplicate it.
          next if Util::Projections.exists?(db, domain, doctype, doc_id)

          content = doc["content"]?.try(&.to_json) || "{}"
          meta_overrides = doc["meta"]?.try do |meta|
            hash = meta.as_h?
            next nil unless hash
            hash.each_with_object(Hash(String, JSON::Any).new) { |(k, v), acc| acc[k] = v }
          end

          # One transaction per document — the same unit the HTTP create
          # route uses — so a hook's side effects roll back with its
          # mutation when anything fails.
          result = Database.with_transaction(db, ignore_if_set: true) do |txn|
            Document::Create.create_from_parsed(
              txn,
              domain,
              doctype,
              JSON.parse(content),
              RBAC::AuthContext.system,
              "system",
              cause: Mutation::Cause.root(Mutation::CauseKind::Seed),
              meta_overrides: meta_overrides,
              doc_id: doc_id,
              skip_authorization: true,
            )
          end
          unless result.is_a?(Document::Create::Result)
            error = result.as(Facet::ServiceError)
            detail = error.details.try(&.map(&.message).join("; "))
            raise "Seed document #{domain}.#{doctype}##{doc_id} failed: #{error.message}#{detail ? " (#{detail})" : ""}"
          end
        end
      end

      # The canonical definition JSON a seed directory stores: the parsed
      # definition file (YAML normalizes to JSON), the optional `script.lua`
      # injected, and the derived per-field `operators` applied. Shared by
      # the create path (raw insert) and both update paths.
      private def self.canonical_definition(dir : String) : String?
        defn_path = definition_file(dir)
        return nil if defn_path.nil?
        defn_raw = parse_content(defn_path)

        script = SEED_FILES["#{dir}/script.lua"]?
        content = script ? inject_script(defn_raw, script) : defn_raw

        # The raw insert bypasses `Doctype::Create`'s struct serialization,
        # so the derived per-field `operators` member would be missing
        # (`Doctype::DerivedOperators` for why the member must exist).
        parsed = DerivedOperators.apply(JSON.parse(content))

        # Prefer the struct round-trip form (`DoctypeDefinition#to_json`) —
        # the form every pipeline write persists. The authored shape differs
        # from it in normalizable noise (booleans the writer always emits,
        # enum values as strings vs objects), and a seed stored raw would
        # false-drift against its own pipeline writes forever. Seeds the
        # struct cannot parse (e.g. `core.Domain`'s `any` field type) keep
        # the derived form — the raw write path stores them verbatim.
        begin
          Doctype::DoctypeDefinition.from_json(parsed.to_json).to_json
        rescue ArgumentError
          parsed.to_json
        end
      end

      # Injects a Lua script into a definition JSON string by adding a
      # `"script"` field.
      private def self.inject_script(defn_raw : String, script : String) : String
        parsed = JSON.parse(defn_raw)
        parsed.as_h["script"] = JSON::Any.new(script)
        parsed.to_json
      end

      # First definition file embedded for a seed directory, as a
      # `SEED_FILES` key (`"{dir}/{filename}"`), or nil.
      private def self.definition_file(dir : String) : String?
        DEFINITION_FILE_NAMES.each do |f|
          key = "#{dir}/#{f}"
          return key if SEED_FILES.has_key?(key)
        end
        nil
      end

      # First existing documents file embedded for a seed directory, as a
      # `SEED_FILES` key, or nil.
      private def self.documents_file(dir : String) : String?
        DOCUMENTS_FILE_NAMES.each do |f|
          key = "#{dir}/#{f}"
          return key if SEED_FILES.has_key?(key)
        end
        nil
      end

      # Parse embedded content based on the file extension. Normalizes YAML
      # to JSON.
      private def self.parse_content(file_key : String) : String
        raw = SEED_FILES[file_key]
        case File.extname(file_key)
        when ".yml", ".yaml"
          yaml = YAML.parse(raw)
          YamlHelper.to_json_any(yaml).to_json
        else
          raw
        end
      end

      # Parses a directory name like `"core.Domain"` into `{"core", "Domain"}`.
      private def self.parse_dir_name(dir_name : String) : {String?, String?}
        parts = dir_name.split(".", 2)
        if parts.size == 2
          {parts[0], parts[1]}
        else
          {nil, nil}
        end
      end

      # Stages the projection GUCs for a raw `core.*` write. The templates
      # come from the stored definition of `qualified_doctype` — the row's
      # doctype — never from the content being written. A definition that
      # cannot be fetched takes the no-definition branch (`clear_all`), the
      # same fallback the document pipeline uses — unless `fallback_defn`
      # supplies the bootstrap case: the write that creates the very
      # definition the templates come from (the `core.DocType` seed), where
      # the parsed content doubles as that definition. Shared by the
      # definition seed pass and the third-pass CollectionView seed.
      private def self.stage_projection_gucs(
        txn : DB::Connection,
        qualified_doctype : String,
        content : JSON::Any,
        fallback_defn : DoctypeDefinition? = nil,
      ) : Nil
        defn = DefinitionStore.fetch(txn, qualified_doctype) || fallback_defn
        if defn
          Document::ProjectionGucs.set_all(txn, defn, content)
        else
          Document::ProjectionGucs.clear_all(txn)
        end
      end

      # Returns true if the core doctype definition already exists and is
      # not deleted. All definitions are stored as core.DocType documents.
      private def self.doctype_exists?(db : DB::Connection, doctype_id : String) : Bool
        Util::Projections.exists?(db, "core", "DocType", doctype_id)
      end

      # Third-pass seed: for every live `core.DocType` projection, ensure at
      # least one non-deleted `core.CollectionView` child exists — every
      # doctype gets a listing surface, container doctypes included
      # (`CollectionView::Defaults` derives the columns). Doctypes that
      # already have child views (manually created or seeded in a prior
      # run) are skipped — the seed never clobbers a user's intent. Uses
      # `system` provenance, matching the first-pass seed.
      private def self.seed_default_collection_views(db : DB::Connection) : Nil
        # Read every live doctype id + raw content. Children-less doctypes
        # are filtered in Ruby (need `definition.children` access).
        rows = db.query_all(
          "SELECT id, content FROM projections " \
          "WHERE domain = 'core' AND doc_type = 'DocType' AND deleted_at IS NULL " \
          "ORDER BY id ASC",
          as: {String, JSON::Any},
        )

        rows.each do |(doctype_id, content)|
          next unless content.as_h?

          definition = Doctype::DoctypeDefinition.from_json(content.to_json)

          # Idempotent: skip if the doctype already has any live view.
          existing = db.query_one?(
            <<-SQL,
              SELECT 1 FROM projections
              WHERE domain = 'core' AND doc_type = 'CollectionView'
                AND meta->>'parent_id' = $1
                AND deleted_at IS NULL
              LIMIT 1
            SQL
            doctype_id,
            as: Int32,
          )
          next unless existing.nil?

          view_content = Doctype::CollectionView::Defaults.build_content(definition)
          meta = %({"parent_id": #{doctype_id.to_json}})
          Database.with_transaction(db, ignore_if_set: true) do |txn|
            # Stage the projection GUCs — the raw create below bypasses the
            # pipeline, and an unstaged GUC stores a NULL corpus (B-78).
            stage_projection_gucs(txn, "core.CollectionView", view_content)
            Mutation::Client.create(
              txn,
              "core",
              "CollectionView",
              content: view_content.to_json,
              meta: meta,
              actioner_id: "system",
            )
          end
        end
      end
    end
  end
end
