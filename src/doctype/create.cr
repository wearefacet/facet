require "json"
require "opentelemetry"
require "pg"
require "../database"
require "../mutation/client"
require "../index"
require "./definition_store"
require "./validation"
require "./draft_target_check"
require "../replication/validator"
require "../rbac"
require "../event"
require "../error"
require "../util/projections"
require "../domain/editors"
require "../document/projection_gucs"

module Facet
  module Doctype
    # Service for creating a new document of a given doctype.
    #
    # Handles two scenarios:
    #
    # 1. **DocType registration** (core.DocType) — validates the body as a
    #    `DoctypeDefinition` via `Doctype::Validation`, then persists
    #    it as a mutation.
    #
    # 2. **General document creation** (future) — looks up the doctype
    #    definition from `core.DocType`, validates via
    #    `Document::Validation`, then persists.
    #
    # Returns a `Mutation::Client::Projection` on success.
    module Create
      # Unified result type.
      record Result,
        projection : Mutation::Client::Projection,
        mutation_id : String

      # Creates a document of the given domain/doctype.
      #
      # Requires an `auth_context` for RBAC authorization.
      # Returns `Result` on success, `Error` on failure.
      def self.call(
        db : DB::Connection,
        domain : String,
        doc_type : String,
        body : String,
        auth_context : RBAC::AuthContext = RBAC::AuthContext.system,
        cause : Mutation::Cause? = nil,
      ) : Result | Facet::ServiceError
        Facet::Telemetry.trace "doctype.create" do |span|
          span["domain"] = domain
          span["doc_type"] = doc_type

          actioner_id = auth_context.account_id

          result = case {domain, doc_type}
                   when {"core", "DocType"}
                     create_doctype_definition(db, body, actioner_id, auth_context, cause)
                   else
                     Facet::ServiceError.new(501, "Not implemented: #{domain}.#{doc_type}")
                   end

          case result
          when Result
            span["doc_id"] = result.projection.id
            span["mutation_id"] = result.mutation_id
          when Facet::ServiceError
            Telemetry.record_error(span, result)
          end

          result
        end
      end

      # ── Private ──────────────────────────────────────────────────────────

      # Returns `Error` if the domain does not exist in the core.Domain projections.
      private def self.domain_exists?(db : DB::Connection, domain : String) : Facet::ServiceError?
        exists = Util::Projections.exists?(db, "core", "Domain", domain)
        exists ? nil : Facet::ServiceError.new(422, "Domain '#{domain}' does not exist. Create it as a core.Domain document first.")
      end

      # Reads the `draft` flag from the source domain's `core.Domain`
      # projection row. Treats a missing row, missing field, or any
      # non-`true` value as "not a draft" (fail-closed — live domains take
      # the strict path). Mirrors `Doctype::Update#draft_domain?`.
      private def self.draft_domain?(db : DB::Connection, domain : String) : Bool
        Util::Projections.draft_domain?(db, domain)
      end

      # Runs the authoring gates after the duplicate guard, in order:
      # schema validation, the draft-target gate, named scopes (live
      # domains only), and the hard replication invariants. Returns the
      # first failure, or `nil` when all gates pass.
      #
      # One cross-doctype rule is enforced at authoring time: a
      # cross-domain reference must not target a draft domain
      # (`DraftTargetCheck` — B-287). The rest of the cross-doctype
      # resolution (reference target existence, replicate grants) stays
      # advisory — see `Doctype::Check` for the diagnostics entry point
      # that surfaces those issues on demand. Draft domains use the
      # relaxed `validate_draft` so the autogenerated `_`-prefixed domain
      # name is accepted.
      private def self.authoring_gate_failure(
        db : DB::Connection,
        definition : DoctypeDefinition,
      ) : Facet::ServiceError?
        draft_mode = draft_domain?(db, definition.domain)

        errors = draft_mode ? Validation.validate_draft(definition) : Validation.validate(definition)
        unless errors.empty?
          return Facet::ServiceError.new(422, "Doctype validation failed", details: errors)
        end

        # Draft-target gate (B-287): a cross-domain reference whose target
        # domain is still a draft stores a draft-qualified token that
        # publish never rewrites. Runs on draft and live domains alike.
        draft_errors = DraftTargetCheck.validate(db, definition)
        unless draft_errors.empty?
          return Facet::ServiceError.new(422, "Cross-domain reference targets a draft domain", details: draft_errors)
        end

        # Validate named scopes declared on this doctype definition against
        # the domain's context sets. Authoring-time only — see RBAC::Validator.
        # In draft mode the domain's `context_sets` are empty (drafts inherit
        # no context sets), so `$<context_set>` references would always be
        # rejected; draft authors use `$self` and literals only. Mirrors
        # `Doctype::Update`'s draft-mode branch.
        unless draft_mode
          scope_errors = RBAC::Validator.validate_named_scopes_for(db, definition)
          return Facet::ServiceError.new(422, "Named scope validation failed", details: scope_errors) unless scope_errors.empty?
        end

        # Hard replication invariants — enforced at authoring time (422),
        # not left advisory. The advisory grant/existence diagnostics stay
        # on `/check` (the full `Validator.validate`). See
        # `Replication::Validator.validate_invariants`.
        rep_errors = Replication::Validator.validate_invariants(definition, db)
        unless rep_errors.empty?
          details = rep_errors.map { |e| ValidationError.new(message: e, code: "schema") }
          return Facet::ServiceError.new(422, "Replication validation failed", details: details)
        end

        nil
      end

      # Handles core.DocType creation: validate the definition, persist it.
      private def self.create_doctype_definition(
        db : DB::Connection,
        body : String,
        actioner_id : String,
        auth_context : RBAC::AuthContext,
        cause : Mutation::Cause? = nil,
      ) : Result | Facet::ServiceError
        # 0. Authorize the doctype creation
        unless RBAC::WriteEnforcer.authorize_create(db, "core", "DocType", auth_context)
          return Facet::ServiceError.new(403, "Forbidden")
        end

        definition = begin
          DoctypeDefinition.from_json(body)
        rescue ex : JSON::ParseException
          return Facet::ServiceError.new(422, "Invalid doctype definition: #{ex.message}")
        end

        # Ensure the domain exists as a core.Domain document. This must
        # happen before validation so we can pick the correct validator:
        # draft domains permit the `_` prefix and skip migration gap checks
        # (mirrors `Doctype::Update`'s draft-mode branch).
        domain_check = domain_exists?(db, definition.domain)
        return domain_check if domain_check.is_a?(Facet::ServiceError)

        # Domain-membership gate. The permission scopes are presence-only at
        # create time (the row does not exist yet), so a role whose only
        # `create core.DocType` grant is scoped to `$domain_editor` is
        # checked here: the target domain must be one the account edits.
        # Wildcard roles and the system bypass pass; a denied caller already
        # failed the enforcer above.
        unless Domain::Editors.authorize_doctype_create?(db, definition.domain, auth_context)
          return Facet::ServiceError.new(403, "Forbidden")
        end

        # Duplicate-registration guard. A repeated POST for the same
        # (domain, doctype) appended a second `create` mutation and
        # returned 201. The other write paths check existence first
        # (`Domain::Copy.upsert_doctype_definition` create-or-updates,
        # `Doctype::Seed` is idempotent), so the plain REST create was the
        # outlier. Reject the duplicate with 409 and name the existing
        # pair; updates go through `Doctype::Update`.
        doc_id = "#{definition.domain}.#{definition.doctype}"
        if Util::Projections.exists?(db, "core", "DocType", doc_id)
          return Facet::ServiceError.new(409, "Doctype '#{doc_id}' already exists")
        end

        # Authoring gates — schema validation, the draft-target gate,
        # named scopes, replication invariants. First failure wins.
        gate_failure = authoring_gate_failure(db, definition)
        return gate_failure if gate_failure

        content_json = definition.to_json

        mut_id, projection = Database.with_transaction(db, ignore_if_set: true) do |txn|
          # Stage the projection GUCs the trigger reads (search corpus,
          # links, display_name). The raw create below stages nothing on
          # its own, and an unstaged GUC stores NULL derived columns
          # (B-78) — a REST-registered doctype then matches nothing on
          # `filters[search]`. The templates come from the stored
          # `core.DocType` definition — the doctype this row is written
          # under — never from the definition being registered (that
          # renders the corpus from the new doctype's document-facing
          # template, which stores NULL or garbage against definition
          # content). The system definition is live before any REST
          # create (the seed registers it); a fetch that still fails
          # takes the no-definition branch, the pipeline fallback.
          core_doctype_defn = DefinitionStore.fetch(txn, "core.DocType")
          if core_doctype_defn
            Document::ProjectionGucs.set_all(txn, core_doctype_defn, JSON.parse(content_json))
          else
            Document::ProjectionGucs.clear_all(txn)
          end

          # The persist + fetch below are wrapped so the mutation is
          # atomic per the service contract.
          #
          # DocType is a child of Domain, so we set parent_id to the domain
          # name (which is the core.Domain document's id). This is derived
          # from the definition itself rather than the route's meta_overrides
          # — every creation path (seed, copy, nested route) agrees by
          # construction: definition.domain always equals the parent domain.
          meta = %({"parent_id": #{definition.domain.to_json}})
          this_mut_id = Mutation::Client.create(
            txn,
            "core",
            "DocType",
            doc_id: doc_id,
            content: content_json,
            meta: meta,
            actioner_id: actioner_id,
            provenance: Mutation::Provenance.from(auth_context),
            cause: cause,
          )

          this_proj = Mutation::Client.fetch_projection(txn, "core", "DocType", doc_id)

          # No default `core.CollectionView` row is created here. A new
          # doctype starts with zero views; the listing renders a starter
          # screen that offers to create one (table, kanban, calendar),
          # and `Doctype::Check` reports an `:info` notice for the
          # viewless state. Views are always user-authored.

          {this_mut_id, this_proj}
        end

        # Trigger index sync asynchronously — indexes are created in a
        # background fiber so the HTTP response is not blocked.
        Index::Manager.sync(db, definition)

        Event::Publisher.enqueue(
          domain: "core", doc_type: "DocType",
          doc_id: "#{definition.domain}.#{definition.doctype}",
          event: "registered", mutation_id: mut_id,
          actioner_id: actioner_id,
        )

        # The replication registry is NOT eagerly refreshed here. The
        # `registered` event enqueued above is delivered by the HTTP
        # layer's `Event::Publisher.flush` (post-commit). The
        # `Subscriber::DoctypeCache` Pub/Sub subscriber receives it and
        # marks the registry stale via `Replication::Manager#mark_registry_stale`;
        # the next registry read rebuilds lazily from the DB.

        Result.new(projection: projection, mutation_id: mut_id)
      end
    end
  end
end
