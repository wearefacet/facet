require "json"
require "pg"
require "../error"
require "../templating"
require "./script_validator"
require "../util/sequence"

module Facet
  module Doctype
    # Validates a `DoctypeDefinition` for schema‑level integrity.
    #
    # This service performs the following validations:
    # - field names are not empty and are valid identifiers
    #   (lower_case_with_underscores or camelCase)
    # - reserved action names are not used
    # - `schema_version >= 1`
    # - `member_of` format is CamelCase
    # - reference definitions have a doctype
    # - Lua script (if present) compiles and exports the required actions
    #
    # Type‑specific field definition validation is delegated to each
    # `FieldType` subclass.
    #
    # The `validate` method family handles **schema-level** checks only
    # — no cross-doctype resolution. Cross-doctype integrity (reference
    # target existence, replicate source/grant) is intentionally NOT
    # enforced at authoring time: it would create ordering dependencies
    # between domains and prohibit legitimate forward references. The
    # runtime replication path already silently no-ops on broken configs,
    # and `Doctype::Check` (the `/check` endpoint) surfaces these as
    # diagnostics on demand. One exception: the write services
    # (`Doctype::Create`, `Doctype::Update`) run `DraftTargetCheck`,
    # which rejects a cross-domain reference whose target domain is
    # still a draft (B-287).
    module Validation
      # Delegates to the single source of truth on DoctypeDefinition.
      RESERVED_ACTIONS = DoctypeDefinition::RESERVED_ACTIONS

      # Field names no doctype may declare. `parent_id` and `search` are
      # system-managed; `display_name` is the reserved template variable
      # (`Templating::Context::DISPLAY_NAME_VARIABLE`); the rest are real
      # `projections` columns. A doctype field with one of these names
      # collides with the column or the reserved variable, so the
      # authoring gate rejects it. The `core.DocType` system seed is the
      # one exemption — it declares `search` and `display_name` so the GET
      # mask keeps those definition keys (see
      # `spec/doctype/core_doctype_seed_keys_guard_spec.cr`).
      RESERVED_FIELD_NAMES = Set{
        "parent_id", "search", "display_name",
        "id", "created_at", "updated_at", "deleted_at", "state", "version", "links",
      }

      # Schema-level validation only (no cross-doctype checks).
      # Returns an array of structured errors (empty if valid).
      #
      # `creation` selects the template gate (B-296): an aggregate root must
      # declare a label or a search template when the definition is created.
      # The update door passes `false` — a doctype created before the gate
      # must stay editable; publish re-runs the gate (see
      # `Domain::PublishGate`).
      def self.validate(definition : DoctypeDefinition, *, creation : Bool = true) : Array(ValidationError)
        errors = [] of ValidationError
        run(definition, errors, draft: false, creation: creation)
        errors
      end

      # Schema-level validation for draft domains.
      #
      # Same as `validate`, but the domain-name regex is relaxed to permit
      # the `_` prefix used by autogenerated draft domain names (e.g.
      # `_abc123`). Migration gap checks are skipped entirely — in draft
      # mode the schema is freely mutable and version may decrease,
      # skip ahead, or carry destructive same-version edits.
      #
      # Cross-doctype replicate fields are **not** validated against
      # source doctypes here: draft domains are isolated from the
      # replication registry (a draft's doctypes never appear as a
      # replication source), so any replicate config a draft declares is
      # inert until publish, at which point the target domain is a live
      # domain and gets fully re-validated on its first doctype update.
      # The template gate does not run in draft mode: a draft is a design
      # sandbox, and the publish gate judges the published shape.
      def self.validate_draft(definition : DoctypeDefinition) : Array(ValidationError)
        errors = [] of ValidationError
        run(definition, errors, draft: true, creation: false)
        errors
      end

      # Shared validation pipeline. `draft` selects the domain-name
      # validator: the draft-aware version permits the `_` prefix used by
      # autogenerated draft domain names; the strict version does not.
      # All other validators run unchanged in both modes.
      private def self.run(
        definition : DoctypeDefinition,
        errors : Array(ValidationError),
        draft : Bool,
        creation : Bool,
      ) : Nil
        validate_doctype_name(definition, errors)
        if draft
          validate_domain_name_draft(definition, errors)
        else
          validate_domain_name(definition, errors)
        end
        validate_schema_version(definition, errors)
        validate_aggregation(definition, errors)
        validate_field_names(definition, errors)
        validate_secret_fields(definition, errors)
        validate_compute_field_type(definition, errors)
        validate_compute_when(definition, errors)
        validate_search(definition, errors)
        validate_display_name(definition, errors)
        validate_templates_present(definition, errors) if creation
        validate_children(definition, errors)
        validate_sidecar(definition, errors)
        validate_sidecars_keys(definition, errors)
        validate_sidecar_surface(definition, errors)
        validate_actions(definition, errors)
        validate_script(definition, errors)
        validate_replicate_schema(definition, errors)
        validate_identifier(definition, errors)
      end

      # ── Private validators ──────────────────────────────────────────
      # Validates that the doctype name is not empty and is valid CamelCase
      private def self.validate_doctype_name(definition, errors : Array(ValidationError))
        name = definition.doctype
        if name.empty?
          errors << ValidationError.new(field: nil, message: "doctype name must not be empty", code: "schema")
        elsif !name.matches?(/^[A-Z][a-zA-Z0-9]*$/)
          errors << ValidationError.new(field: nil, message: "doctype '#{name}' must be CamelCase alphanumeric and cannot start with a digit", code: "schema")
        end
      end

      # Validates the domain name for a draft domain. Permits the `_`
      # prefix (used by autogenerated draft names) in addition to the
      # normal lowercase alphanumeric-with-dashes set. The prefix is
      # followed by alphanumeric characters (the autogenerated suffix is
      # hex, so it may start with a digit).
      private def self.validate_domain_name_draft(definition, errors : Array(ValidationError))
        domain = definition.domain
        if domain.empty?
          errors << ValidationError.new(field: nil, message: "domain must not be empty", code: "schema")
        elsif !domain.matches?(/^_?[a-z0-9][a-z0-9\-]*$/)
          errors << ValidationError.new(field: nil, message: "domain '#{domain}' must be lowercase alphanumeric with dashes and cannot start with a digit", code: "schema")
        end
      end

      # Validates that the domain name is a valid lowercase-with-dashes identifier
      private def self.validate_domain_name(definition, errors : Array(ValidationError))
        domain = definition.domain
        if domain.empty?
          errors << ValidationError.new(field: nil, message: "domain must not be empty", code: "schema")
        elsif !domain.matches?(/^[a-z][a-z0-9\-]*$/)
          errors << ValidationError.new(field: nil, message: "domain '#{domain}' must be lowercase alphanumeric with dashes and cannot start with a digit", code: "schema")
        end
      end

      # Validates that schema_version >= 1
      private def self.validate_schema_version(definition, errors : Array(ValidationError))
        if definition.schema_version < 1
          errors << ValidationError.new(field: nil, message: "schema_version must be >= 1 (got: #{definition.schema_version})", code: "schema")
        end
      end

      # Validates the aggregation pair. A doctype is exactly one of two
      # things: an aggregate root (`aggregate_root: true`, no `member_of`)
      # or an owned child (`aggregate_root: false` plus `member_of`). The
      # hard contradiction — both declared at once — is rejected here.
      # The softer half-state (`aggregate_root: false`, no `member_of`) is
      # reported by `Doctype::Check` instead: the struct defaults
      # `aggregate_root` to `false`, so that shape is common in
      # programmatically built definitions, and the runtime treats it as
      # its own aggregate root (see `Helpers.resolve_aggregate_root`).
      private def self.validate_aggregation(definition, errors : Array(ValidationError))
        if parent = definition.member_of
          if parent.empty?
            errors << ValidationError.new(field: nil, message: "member_of must not be empty", code: "schema")
          elsif !parent.matches?(/^[A-Z][a-zA-Z0-9]*$/)
            errors << ValidationError.new(field: nil, message: "member_of '#{parent}' must be CamelCase alphanumeric", code: "schema")
          end
          if definition.aggregate_root
            errors << ValidationError.new(field: nil, message: "doctype '#{definition.doctype}' declares both aggregate_root: true and member_of '#{parent}' — a doctype is either an aggregate root or a member of one, not both", code: "schema")
          end
        end
      end

      # Validates that all child relationship names are valid identifiers
      # and that child doctypes are in the same domain.
      private def self.validate_children(definition, errors : Array(ValidationError))
        definition.children.each do |rel_name, child_def|
          if rel_name.empty?
            errors << ValidationError.new(field: nil, message: "Child relationship name must not be empty", code: "schema")
          elsif !rel_name.matches?(/^[a-z_][a-z0-9_]*$/)
            errors << ValidationError.new(field: nil, message: "Child relationship name '#{rel_name}' is not a valid identifier (use lower_case_with_underscores)", code: "schema")
          end

          if child_def.doctype.empty?
            errors << ValidationError.new(field: nil, message: "Child relationship '#{rel_name}' must specify a doctype", code: "schema")
          end

          # Children must not use a domain prefix — they are always
          # in the same domain as the parent doctype.
          if child_def.doctype.includes?('.')
            errors << ValidationError.new(field: nil, message: "Child relationship '#{rel_name}': doctype '#{child_def.doctype}' must not include a domain prefix. Children are always in the same domain as the parent.", code: "schema")
          end
        end
      end

      # Validates the `sidecar: true` flag on a sidecar doctype. A sidecar
      # must live in `core` and have a `target` reference field that is
      # required, read_only, and has no default — only the system sets it
      # via the host's nested route. Other reference fields (e.g. an
      # `author` ownership anchor) are allowed.
      private def self.validate_sidecar(definition, errors : Array(ValidationError))
        return unless definition.sidecar

        unless definition.domain == "core"
          errors << ValidationError.new(field: nil, message: "sidecar doctypes must live in the 'core' domain", code: "schema")
        end

        target = definition.fields["target"]?
        if target.nil?
          errors << ValidationError.new(field: nil, message: "sidecar doctype must have a field named 'target'", code: "schema")
          return
        end

        unless target.reference?
          errors << ValidationError.new(field: nil, message: "the 'target' field of a sidecar doctype must be of type 'reference'", code: "schema")
        end
        unless target.required
          errors << ValidationError.new(field: nil, message: "the 'target' field of a sidecar doctype must be required", code: "schema")
        end
        unless target.read_only?
          errors << ValidationError.new(field: nil, message: "the 'target' field of a sidecar doctype must be read_only: true (so only the system can set it)", code: "schema")
        end
        unless target.default.nil?
          errors << ValidationError.new(field: nil, message: "the 'target' field of a sidecar doctype must not have a default", code: "schema")
        end
      end

      # Validates the optional `surface` field on a sidecar doctype. It must
      # be a lowercase identifier and is only meaningful with `sidecar: true`.
      # A surface id the frontend does not register is never a hard gate here —
      # the frontend falls back to the basic DVT surface.
      private def self.validate_sidecar_surface(definition, errors : Array(ValidationError))
        surface = definition.surface
        return if surface.nil?

        unless definition.sidecar
          errors << ValidationError.new(field: nil, message: "surface is only meaningful on a sidecar doctype (sidecar: true)", code: "schema")
          return
        end

        unless surface.matches?(/^[a-z][a-z0-9_]*$/)
          errors << ValidationError.new(field: nil, message: "surface '#{surface}' is not a valid lowercase identifier", code: "schema")
        end
      end

      # Validates the `sidecars` map on a host doctype: segment names must
      # be valid identifiers, must not collide with `children` keys, and
      # each ref's column must be a non-empty string (the parser defaults
      # it to "target", so this is a safety assertion).
      private def self.validate_sidecars_keys(definition, errors : Array(ValidationError))
        definition.sidecars.each do |segment, ref|
          if segment.empty?
            errors << ValidationError.new(field: nil, message: "sidecar segment must not be empty", code: "schema")
          elsif !segment.matches?(/^[a-z_][a-z0-9_]*$/)
            errors << ValidationError.new(field: nil, message: "sidecar segment '#{segment}' is not a valid identifier (use lower_case_with_underscores)", code: "schema")
          end

          if definition.children.has_key?(segment)
            errors << ValidationError.new(field: nil, message: "sidecar segment '#{segment}' collides with a child relationship of the same name", code: "schema")
          end

          if ref.column.empty?
            errors << ValidationError.new(field: nil, message: "sidecar segment '#{segment}' must specify a non-empty column", code: "schema")
          end
        end
      end

      # Validates that all field names are valid identifiers and delegates
      # type‑specific checks to the FieldType subclass. Also checks for
      # conflicting field attributes.
      private def self.validate_field_names(definition, errors : Array(ValidationError))
        definition.fields.each do |field_name, field|
          if RESERVED_FIELD_NAMES.includes?(field_name)
            errors << ValidationError.new(field: field_name, message: "is a reserved field name and cannot be used", code: "reserved")
            next
          end

          if field_name.empty?
            errors << ValidationError.new(field: nil, message: "Field name must not be empty", code: "schema")
          elsif !field_name.matches?(/^[a-z_][a-z0-9_]*$/) &&
                !field_name.matches?(/^[a-z][a-zA-Z0-9]*$/)
            errors << ValidationError.new(field: field_name, message: "is not a valid identifier (use lower_case_with_underscores or camelCase)", code: "schema")
          end

          # read_only and write_only are mutually exclusive
          if field.read_only? && field.write_only?
            errors << ValidationError.new(field: field_name, message: "cannot be both read_only and write_only", code: "schema")
          end

          validate_field_tags(field_name, field, errors)

          # Delegate definition validation to the field's type class
          if field_type = field.type
            field_type.validate_definition(field, field_name, errors)
          end

          # Cross-cutting filter-capability / field-type compatibility
          # check. Field types own their own allowed-capability lists via
          # `validate_definition`; here we reject capabilities that make
          # no sense for the field type at all — range capabilities on
          # scalar fields, scalar capabilities on range/container fields,
          # `membership` on `dictionary`, etc. Belt-and-braces parallel
          # to the per-type `allowed_capabilities` lists.
          validate_field_filters(field_name, field, errors)
        end
      end

      # Rejects empty tag strings on a field's `tags` array. Tags are
      # free-form sensitivity labels — matched exactly against role
      # `visible_tags` and against `core.DomainGrant` resource entries —
      # so a blank label would match nothing and only confuse both gates.
      private def self.validate_field_tags(field_name, field, errors : Array(ValidationError))
        tags = field.tags
        return if tags.nil?

        tags.each_with_index do |tag, i|
          if tag.blank?
            errors << ValidationError.new(
              field: field_name,
              message: "has an empty tags entry at position #{i + 1} — remove it or name a tag",
              code: "schema",
            )
          end
        end
      end

      # Whole-definition rule for the compute keys: `compute` and
      # `compute_when` run only on a `data` field. The compute pass walks
      # `computed_field_names`, which holds `data` fields only, so any
      # other field type stores the keys and never evaluates them (B-274).
      # Reject at authoring time instead of a rule that never fires.
      # `secret` fields are skipped: `SecretType#validate_definition`
      # already rejects the keys there with its own message.
      private def self.validate_compute_field_type(definition, errors : Array(ValidationError))
        definition.fields.each do |field_name, field|
          next if field.computed?
          next if field.type.try(&.type_name) == "secret"

          type_name = field.type.try(&.type_name) || "none"
          if field.compute
            reject_compute_key(field_name, "compute", type_name, errors)
          end
          if field.compute_when
            reject_compute_key(field_name, "compute_when", type_name, errors)
          end
        end
      end

      # One error per declared key, so the message always names the key
      # the author must remove.
      private def self.reject_compute_key(
        field_name : String,
        key : String,
        type_name : String,
        errors : Array(ValidationError),
      ) : Nil
        errors << ValidationError.new(
          field: field_name,
          message: "'#{key}' applies only to a data field — this field has type '#{type_name}' and never evaluates it; remove the key or change the type to data",
          code: "schema",
        )
      end

      # Whole-definition rules for a computed field's `compute_when` list.
      # Each entry must name a field of this doctype (a value trigger) or a
      # key of `children` (a relationship trigger — the field re-runs when
      # that relationship's children mutate). Anything else can never fire,
      # so it fails at authoring time instead of silently never running.
      private def self.validate_compute_when(definition, errors : Array(ValidationError))
        definition.fields.each do |field_name, field|
          compute_when = field.compute_when
          next if compute_when.nil?

          compute_when.each do |trigger|
            next if definition.fields.has_key?(trigger)
            next if definition.children.has_key?(trigger)

            errors << ValidationError.new(
              field: field_name,
              message: "names an unknown compute_when trigger '#{trigger}' — use a field of this doctype or a child relationship",
              code: "schema",
            )
          end
        end
      end

      # Rejects filter capabilities that are not compatible with the
      # field's declared type. Each `FilterCapability#valid_for?` is the
      # single source of truth for the authoring matrix:
      # - `interval` only on `period` / `dateperiod`.
      # - `membership` only on `array` (not `dictionary`).
      # - `currency` only on `money`.
      # - `text_search` only on string-like types.
      # - `comparison` only on scalar / numeric / datetime / money (not
      #   range, not container).
      # - `equality` on every single-value type (scalar + range).
      #
      # Field types that declare their own `allowed_capabilities` list
      # (period, dateperiod, money, duration) enforce the same rule a
      # second time from the type's own perspective — the lists and
      # `valid_for?` are kept in sync deliberately (belt-and-braces).
      private def self.validate_field_filters(field_name, field, errors : Array(ValidationError))
        type = field.type
        return if type.nil?

        caps = field.filters
        return if caps.nil? || caps.empty?

        caps.each do |cap|
          unless cap.valid_for?(type)
            errors << ValidationError.new(
              field: field_name,
              message: "filter capability '#{cap.to_s_lowercase}' is not valid on a #{type.type_name} field",
              code: "schema",
            )
          end
        end
      end

      # Whole-definition rules for `secret` fields. Leaf-level attribute
      # rules live in `SecretType#validate_definition`; these need container
      # and template context:
      #
      # - secret leaves are allowed at top level and inside `object`
      #   properties only — never inside arrays or dictionaries, because
      #   slot paths (`field[i]`, `field[key]`) must be shift-stable when
      #   the container changes shape;
      # - a secret field's root field must not appear in the doctype's
      #   `search` paths or `display_name` template — both surfaces would
      #   copy the marker (and, historically, any inline value) into a
      #   plaintext projection column;
      # - `secret` is banned as an action argument type — a staged handle
      #   belongs to a document field slot, not to a script parameter.
      private def self.validate_secret_fields(definition, errors : Array(ValidationError))
        definition.fields.each do |field_name, field|
          validate_secret_placement(definition, field_name, field, errors)
        end

        definition.actions.each do |action_name, action|
          action.args.each do |arg_name, arg|
            if arg.type.type_name == "secret"
              errors << ValidationError.new(
                field: "#{action_name}.#{arg_name}",
                message: "secret cannot be used as an action argument",
                code: "schema",
              )
            end
          end
        end
      end

      private def self.validate_secret_placement(
        definition,
        field_name : String,
        field : FieldDefinition,
        errors : Array(ValidationError),
      ) : Nil
        type = field.type
        return if type.nil?

        case type.type_name
        when "secret"
          reject_secret_in_templates(definition, field_name, errors)
        when "array"
          if (items = field.items) && items.type.try(&.type_name) == "secret"
            errors << ValidationError.new(
              field: "#{field_name}.items",
              message: "secret fields are not allowed inside arrays (slot paths must be shift-stable)",
              code: "schema",
            )
          end
        when "dictionary"
          if (values = field.dictionary_value) && values.type.try(&.type_name) == "secret"
            errors << ValidationError.new(
              field: "#{field_name}.values",
              message: "secret fields are not allowed inside dictionaries (slot paths must be shift-stable)",
              code: "schema",
            )
          end
        when "object"
          validate_object_secret_properties(definition, field_name, field, errors)
        end
      end

      private def self.validate_object_secret_properties(
        definition,
        field_name : String,
        field : FieldDefinition,
        errors : Array(ValidationError),
      ) : Nil
        props = field.properties
        return if props.nil?
        if props.any? { |_prop, sub| sub.type.try(&.type_name) == "secret" }
          reject_secret_in_templates(definition, field_name, errors)
        end
      end

      # Rejects a `search` or `display_name` template whose root variables
      # resolve to a doctype field that carries (or contains) a secret leaf.
      private def self.reject_secret_in_templates(
        definition,
        root_field : String,
        errors : Array(ValidationError),
      ) : Nil
        if template = definition.search
          if Templating::Engine.roots(template).includes?(root_field)
            errors << ValidationError.new(
              field: nil,
              message: "search template must not reference the secret field '#{root_field}'",
              code: "schema",
            )
          end
        end

        if template = definition.display_name
          if Templating::Engine.roots(template).includes?(root_field)
            errors << ValidationError.new(
              field: nil,
              message: "display_name template must not reference the secret field '#{root_field}'",
              code: "schema",
            )
          end
        end
      end

      # Validates the `search` template on the doctype definition. The
      # template must compile, and each root variable must reference an
      # existing top-level field, the reserved `content` variable, or the
      # reserved `display_name` variable (the write path binds the
      # document's display label for it).
      private def self.validate_search(definition, errors : Array(ValidationError))
        template = definition.search
        return if template.nil? || template.empty?

        validate_template(template, "search", definition, errors, allow_display_name: true)
      end

      # Validates the `display_name` template on the doctype definition.
      # The template must compile, and each root variable must reference an
      # existing top-level field (or the reserved `content` variable).
      # Reference fields are allowed — they are resolved at runtime via the
      # resolver. The template must not reference the `display_name` column
      # itself: the self-reference would read the value the same write is
      # computing.
      private def self.validate_display_name(definition, errors : Array(ValidationError))
        template = definition.display_name
        return if template.nil? || template.empty?

        validate_template(template, "display_name", definition, errors)
      end

      # The label gate (B-296): an aggregate root must be findable. A
      # doctype with neither template keeps a NULL `search` and a NULL
      # `display_name`, so the cross-doctype search skips it and the bare
      # `search` filter matches only the row id — the reference picker then
      # answers "no matches" while rows exist. `search` defaults to
      # `{{ display_name }}`, so declaring the label alone is enough.
      #
      # An owned child (`member_of`) is exempt: it is reached through its
      # parent, and `Doctype::Check` reports the missing label as a notice.
      # A doctype with `aggregate_root: false` and no `member_of` is exempt
      # too: it is not an aggregate root, so the runtime never surfaces it
      # through the cross-doctype search, and `Doctype::Check` flags the
      # missing root declaration itself (`:composition` warning). The rule
      # applies to a declared template only — an empty string is "not
      # declared".
      private def self.validate_templates_present(definition, errors : Array(ValidationError))
        return unless definition.aggregate_root
        return if declared?(definition.display_name) || declared?(definition.search)

        errors << ValidationError.new(
          field: nil,
          message: "doctype '#{definition.doctype}' declares neither a display_name nor a search template — " \
                   "documents would not be findable (the search filter matches the row id only); " \
                   "declare display_name (search defaults to it) or a search template",
          code: "schema",
        )
      end

      private def self.declared?(template : String?) : Bool
        !template.nil? && !template.strip.empty?
      end

      # Shared template validation: compile, then check every root variable
      # against the doctype fields. This catches typos at authoring time.
      # Variables used inside tag arguments (`{% if %}`, `{% for %}`) are not
      # visible to the AST and are not checked.
      #
      # The reserved `display_name` variable is legal only in a `search`
      # template (`allow_display_name`); in a `display_name` template it is
      # a self-reference and is rejected.
      private def self.validate_template(
        template : String,
        label : String,
        definition,
        errors : Array(ValidationError),
        allow_display_name : Bool = false,
      ) : Nil
        roots = begin
          Templating::Engine.roots(template)
        rescue ex : Templating::Error
          errors << ValidationError.new(field: nil, message: "#{label}: #{ex.message}", code: "schema")
          return
        end

        roots.each do |root|
          next if root == Templating::Context::CONTENT_VARIABLE
          if root == Templating::Context::DISPLAY_NAME_VARIABLE
            next if allow_display_name
            errors << ValidationError.new(
              field: nil,
              message: "#{label} template must not reference the display_name column",
              code: "schema",
            )
            next
          end
          unless definition.fields.has_key?(root)
            errors << ValidationError.new(field: nil, message: "#{label} template: '#{root}' is not defined in the doctype fields", code: "schema")
          end
        end
      end

      # Validates that no reserved action names are used and no conflicts
      # with child relationship names exist.
      private def self.validate_actions(definition, errors : Array(ValidationError))
        definition.actions.each_key do |action_name|
          if RESERVED_ACTIONS.includes?(action_name)
            errors << ValidationError.new(field: nil, message: "Action '#{action_name}' is reserved and cannot be used", code: "schema")
          end

          # An action cannot shadow a child relationship (POST ambiguity)
          if definition.children.has_key?(action_name)
            errors << ValidationError.new(field: nil, message: "Action '#{action_name}' conflicts with child relationship '#{action_name}'", code: "schema")
          end
        end

        # Also check the reverse: child names can't shadow actions
        definition.children.each_key do |child_name|
          if definition.actions.has_key?(child_name)
            errors << ValidationError.new(field: nil, message: "Child '#{child_name}' conflicts with action '#{child_name}'", code: "schema")
          end
        end
      end

      # Validates the Lua script (if present) compiles and exports the
      # required action functions.
      #
      # A definition that declares named actions but ships no script is
      # rejected: named actions run only through the doctype's Lua script,
      # so the definition would publish broken and answer 422 on every
      # invocation (B-299). The same holds for `migrations` (B-301): the
      # lazy migration engine refuses to run without the script, so a PUT
      # that drops it would strand every document below the schema version.
      # The same holds for computed fields (B-274): a `data` field evaluates
      # only through the doctype's Lua script, so without it the field stays
      # unset on every write — the compute pass merges a nil value, which
      # deletes the field from the document content.
      # System doctypes whose declared actions are served by dedicated HTTP
      # routes (e.g. `core.DomainGrant` activate/deactivate) are seeded
      # directly and never pass this gate.
      private def self.validate_script(definition, errors : Array(ValidationError))
        script = definition.script
        if script.nil? || script.empty?
          unless definition.actions.empty?
            errors << ValidationError.new(
              field: nil,
              message: "actions are declared but no script is defined — a named action runs only through the doctype's Lua script; add the script or remove the actions",
              code: "schema",
            )
          end
          unless definition.migrations.empty?
            errors << ValidationError.new(
              field: nil,
              message: "migrations are declared but no script is defined — a migration function runs only through the doctype's Lua script; add the script or remove the migrations",
              code: "schema",
            )
          end
          unless definition.computed_field_names.empty?
            errors << ValidationError.new(
              field: nil,
              message: "computed fields are declared but no script is defined — a computed data field evaluates only through the doctype's Lua script and would stay unset on every write; add the script or remove the compute declarations",
              code: "schema",
            )
          end
          return
        end

        script_errors = ScriptValidator.validate(script, definition)
        errors.concat(script_errors)
      end

      # Schema-level validation for replicate fields.
      #
      # Checks that:
      # - `on_source_delete` is a valid value ("keep" or "unset") and is
      #   declared only on a field that carries a `replicate` config (B-45 —
      #   the registry reads it from the replica field only, so a bare
      #   declaration is a policy that never fires)
      # - A field with `replicate` is not also `compute` or vice versa
      # - A field with `replicate` is not `required` or `unique` — the value
      #   is server-populated from the source document, so a user payload can
      #   neither provide it (write gate) nor satisfy a required check at
      #   create time, and uniqueness is governed by the source field
      # - The `via` field exists on the same doctype
      # - The `via` field is a reference type
      private def self.validate_replicate_schema(definition, errors : Array(ValidationError))
        definition.fields.each do |field_name, field|
          rep = field.replicate

          # `on_source_delete` is consumed only through the replication
          # registry, which reads it from the field that carries the
          # `replicate` config. Declaring it on any other field stores the
          # value and never applies it (B-45) — reject at authoring so the
          # author is pointed at the replica field.
          if rep.nil? && field.on_source_delete != "keep"
            errors << ValidationError.new(field: field_name, message: "'on_source_delete' applies to replicated fields — declare 'replicate' on this field or remove the key", code: "schema")
            next
          end
          next if rep.nil?

          # Validate on_source_delete value
          unless %w[keep unset].includes?(field.on_source_delete)
            errors << ValidationError.new(field: field_name, message: "replicate on_source_delete must be 'keep' or 'unset' (got: #{field.on_source_delete})", code: "schema")
          end

          # Cannot be both computed and replicated
          if field.computed?
            errors << ValidationError.new(field: field_name, message: "cannot be both computed (data) and replicated", code: "schema")
          end

          # A replica field is server-populated, so user-facing constraints
          # on it have no path to satisfaction: the write gate rejects the
          # key in the payload while the required check demands it.
          if field.required
            errors << ValidationError.new(field: field_name, message: "replicated field cannot be required — the value is pulled from the source document", code: "schema")
          end
          if field.unique
            errors << ValidationError.new(field: field_name, message: "replicated field cannot be unique — uniqueness is governed by the source field", code: "schema")
          end

          # The `via` field must exist on the same doctype
          via_field_name = rep.via
          via_field = definition.fields[via_field_name]?
          if via_field.nil?
            errors << ValidationError.new(field: field_name, message: "replicate 'via' field '#{via_field_name}' does not exist on #{definition.qualified_name}", code: "schema")
            next
          end

          # The `via` field must be a reference type
          unless via_field.reference?
            errors << ValidationError.new(field: field_name, message: "replicate 'via' field '#{via_field_name}' must be a reference field (got type: #{via_field.type.try(&.type_name) || "none"})", code: "schema")
          end
        end
      end

      # Validates migration integrity:
      # - Every version from 1 to (schema_version - 1) must have a migration
      #   entry, unless schema_version == 1.
      # - Each migration version key must be parseable as an integer.
      # - Migration function names must follow the convention.
      def self.validate_migrations(definition : DoctypeDefinition, errors : Array(ValidationError), current_version : Int32) : Nil
        return if definition.schema_version == 1

        # Every version gap from current_version to definition.schema_version - 1
        # must have a migration entry.
        (current_version...definition.schema_version).each do |from_ver|
          key = from_ver.to_s
          func_name = definition.migrations[key]?
          if func_name.nil?
            errors << ValidationError.new(field: nil, message: "Migration from v#{from_ver} to v#{from_ver + 1} is missing: add '\"#{key}\": \"migrate_from_#{key}\"' to 'migrations'", code: "schema")
          elsif func_name.empty?
            errors << ValidationError.new(field: nil, message: "Migration function name for v#{from_ver} must not be empty", code: "schema")
          end
        end

        # All migration version keys must be valid integers
        definition.migrations.each_key do |ver_str|
          ver = ver_str.to_i?
          if ver.nil?
            errors << ValidationError.new(field: nil, message: "Migration version '#{ver_str}' is not a valid integer", code: "schema")
          elsif ver >= definition.schema_version
            errors << ValidationError.new(field: nil, message: "Migration version #{ver} is >= current schema_version #{definition.schema_version}", code: "schema")
          end
        end
      end

      # Validates the `identifier` block on the doctype definition.
      #
      # - Template must compile via `Util::Sequence` (valid vars, at least
      #   one `#` group, digit group width within limits).
      # - Template must not be empty.
      private def self.validate_identifier(definition : DoctypeDefinition, errors : Array(ValidationError))
        id_defn = definition.identifier
        return if id_defn.nil?

        template = id_defn.template
        if template.empty?
          errors << ValidationError.new(field: nil, message: "identifier.template must not be empty", code: "schema")
          return
        end

        begin
          Util::Sequence.next(template, nil)
        rescue ex : ArgumentError
          errors << ValidationError.new(field: nil, message: "identifier.template '#{template}': #{ex.message}", code: "schema")
        end
      end

      # Runs all validations plus migration validation when current_version
      # is provided (for updates).
      def self.validate(
        definition : DoctypeDefinition,
        current_version : Int32,
        *,
        creation : Bool = true,
      ) : Array(ValidationError)
        errors = validate(definition, creation: creation)
        validate_migrations(definition, errors, current_version)
        errors
      end
    end
  end
end
