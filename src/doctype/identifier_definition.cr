require "json"

module Facet
  module Doctype
    # Configuration for sequential identifier generation.
    #
    # When present on a doctype definition, document IDs are generated
    # from the `template` using `Util::Sequence` instead of the default
    # ULID. When `genonly` is `true`, the generator **always** produces
    # the next identifier — callers cannot supply a custom ID.
    struct IdentifierDefinition
      include JSON::Serializable

      # The sequence template (e.g. `"INV-{year}-####"`).
      getter template : String

      # When `true`, the identifier is always generated by the system;
      # callers cannot pass a custom `doc_id` during creation.
      getter? genonly : Bool = false

      def initialize(@template : String, @genonly : Bool = false)
      end
    end
  end
end
